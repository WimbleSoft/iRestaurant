        <div class="container">
            <div class="navbar-left mr-4">
                <button class="navbar-toggler" type="button">&#9776;</button>
                <a class="navbar-brand" href="#">
                    <img class="logo-light" src="../Content/Home/assets/img/logo-light.png" alt="logo">
                    <img class="logo-dark" src="../Content/Home/assets/img/logo-dark.png" alt="logo">
                </a>
            </div>
            <section class="navbar-mobile">
                <nav class="nav nav-navbar mr-auto">
                    <a class="btn btn-round btn-outline-secondary" href="#home">Home</a>
                    <a class="btn btn-round btn-outline-secondary" href="#features">Features</a>
                    <a class="btn btn-round btn-outline-secondary" href="#pricing">Pricing</a>
                    <a class="btn btn-round btn-outline-secondary" href="#contact">Contact</a>
                </nav>
                <div>
                    <a class="btn btn-sm btn-light btn-round btn-outline-primary ml-lg-5 mr-2" href="#">Login</a>
                    <a class="btn btn-sm btn-round btn-outline-success" href="#">Sign up</a>
                </div>
            </section>
        </div>
    </nav><!-- /.navbar -->
    <!-- Header -->
    <header class="header text-white h-fullscreen bg-dark pb-0 overflow-hidden" style="background-image: url(../Content/Home/assets/img/vector/16.png); background-color: #262a37;">
        <div class="overlay opacity-95" style="background-color: #262a37;"></div>
        <canvas class="constellation" data-color="rgba(255,255,255,0.3)"></canvas>
        <div class="container text-center">
            <div class="row align-items-center h-100">
                <div class="col-md-8 mx-auto">
                    <h1>Boost your business's efficiency with iRestaurant</h1>
                    <p class="lead mt-4 mb-7">A multi-platform order tracking and optimization system for restaurants, cafes and hotels.</p>
                </div>
                <div class="col-12 align-self-end text-center">
                    <a class="scroll-down-1 scroll-down-white" href="#info"><span></span></a>
                </div>
                <div class="col-md-8 mx-auto align-self-end">
                    <img src="../Content/Home/assets/img/preview/laptop-2.png" alt="img" data-aos="fade-up">
                </div>
            </div>
        </div>
    </header><!-- /.header -->
    <!-- Main Content -->
    <main class="main-content">
        <!-- INFO -->
        <section class="section" id="info" style="background-image: linear-gradient(135deg, #f9f7ff 0%, #fff 50%, #f6f3ff 100%);">
            <div class="container">
                <div class="row align-items-center h-100">
                    <div class="col-md-5">
                        <h1>Make your <span class="text-warning">restaurant</span>, <span class="text-info">hotel</span> or <span class="text-danger">cafe</span> <br> more efficient.</h1>
                        <p class="lead mt-5 mb-8">Based on the orders taken on your company's and branches' waiter and table tablets, monitor staff performance, product sales and stock levels in real time from your computer or mobile device, for any time period you choose. <br>Sign up now and enjoy a 30-day free trial.</p>
                        <a class="btn btn-round btn-primary" href="#howitworks">Learn more</a>
                        <a class="btn btn-round btn-outline-secondary ml-3" href="#pricing">Try it now</a>
                    </div>
                    <div class="col-md-6 ml-auto">
                        <img src="../Content/Home/assets/img/vector/17.png" alt="img">
                    </div>
                </div>
            </div>
        </section>
