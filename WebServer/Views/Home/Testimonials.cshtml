                            <div class="text-center gap-xy-2">
                                <a href="#"><img class="img-fadein" src="../Content/Home/assets/img/app/badge-apple.png" alt="download on app store"></a>
                                <a href="#"><img class="img-fadein" src="../Content/Home/assets/img/app/badge-google.png" alt="download on google play"></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
