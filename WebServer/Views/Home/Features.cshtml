@{ 
    Layout = "~/Views/Shared/home_Layout.cshtml";
    ViewBag.Title = "Features";
}

    <!-- Main Content -->
<main class="main-content">
    <!-- FEATURES -->
    <section class="section" id="features">
        <div class="container">
            <header class="section-header">
                <small>Features</small>
                <h2>Perfect Harmony</h2>
                <hr>
                <p class="lead">Every component works seamlessly with the others.</p>
            </header>

            <div class="row gap-y">
                <div class="col-md-8 mx-auto mb-7">
                    <img src="../Content/Home/assets/img/preview/feature-tablet.png" alt="..." data-aos="fade-up" data-aos-duration="2000">
                </div>

                <div class="w-100"></div>

                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-dark w-70px"><i class="icon-mobile"></i></div>
                        <div class="media-body">
                            <h5>Multi-platform</h5>
                            <p>iRestaurant runs smoothly on every platform.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-primary w-70px"><i class="icon-gears"></i></div>
                        <div class="media-body">
                            <h5>Customizable</h5>
                            <p>Configure settings separately for each of your branches.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-info w-70px"><i class="icon-tools"></i></div>
                        <div class="media-body">
                            <h5>Interface Kits</h5>
                            <p>Set up your tablets as waiter terminals or table terminals.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-warning w-70px"><i class="icon-layers"></i></div>
                        <div class="media-body">
                            <h5>Permission Chain</h5>
                            <p>You assign authorized staff and managers, and authorized staff can in turn assign regular staff.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-danger w-70px"><i class="icon-recycle"></i></div>
                        <div class="media-body">
                            <h5>Eco-Friendly</h5>
                            <p>Take orders without old-fashioned paper order slips.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-success w-70px"><i class="icon-chat"></i></div>
                        <div class="media-body">
                            <h5>Support</h5>
                            <p>Buy a license and get every update instantly.</p>
                        </div>
                    </div>
                </div>



            </div>
            <div id="morefeatures" class="row gap-y">
                <div class="w-100"></div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-success w-70px"><i class="icon-printer"></i></div>
                        <div class="media-body">
                            <h5>Thermal Printer</h5>
                            <p>Print orders on the kitchen and staff printers, and reports on the cashier printer.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-primary w-70px"><i class="icon-desktop"></i></div>
                        <div class="media-body">
                            <h5>Live Display</h5>
                            <p>Show your orders on the kitchen display.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-warning w-70px"><i class="icon-megaphone"></i></div>
                        <div class="media-body">
                            <h5>Announcement System</h5>
                            <p>Show announcements on your tablets, and publish them on your website with AnnouncementApi.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-info w-70px"><i class="icon-wallet"></i></div>
                        <div class="media-body">
                            <h5>Revenue Reporting</h5>
                            <p>Track cashier, stock and revenue entries for any time period you choose.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-danger w-70px"><i class="icon-lock"></i></div>
                        <div class="media-body">
                            <h5>High Security</h5>
                            <p>The entire system is protected with 256-bit encryption.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-dark w-70px"><i class="icon-hourglass"></i></div>
                        <div class="media-body">
                            <h5>Fast Processing</h5>
                            <p>High-performance servers and fast algorithms keep every operation quick.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-warning w-70px"><i class="icon-piechart"></i></div>
                        <div class="media-body">
                            <h5>Optimal Results</h5>
                            <p>Product sales by day and payments by payment type are presented as charts.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-primary w-70px"><i class="icon-profile-male"></i></div>
                        <div class="media-body">
                            <h5>Staff Performance</h5>
                            <p>See how your staff perform at taking orders. (Branch management only)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="media">
                        <div class="lead-6 line-height-1 text-success w-70px"><i class="icon-presentation "></i></div>
                        <div class="media-body">
                            <h5>Branch Comparison</h5>
                            <p>See which of your branches are making or losing money.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row gap-y">
                <div class="col-12 text-center">
                    <br><br>
                    <a class="btn btn-lg btn-primary" onclick="moreOptions(this)" href="#">More Features</a>
                </div>
            </div>

        </div>
    </section>
    <!-- /.FEATURES -->

    <script>

        document.getElementById('morefeatures').style.display = 'none';
        function moreOptions(item) {
            // Reveal the extra features and hide the button
            document.getElementById('morefeatures').style.display = 'flex';
            $(item).hide();
        }
    </script>

</main><!-- /.main-content -->
    <!-- Footer -->
    