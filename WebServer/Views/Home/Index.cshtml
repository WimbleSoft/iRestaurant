@{
    Layout = "~/Views/Shared/home_Layout.cshtml";
    ViewBag.Title = "Home";
}

<!-- Header -->
<header id="home" class="header text-white h-fullscreen bg-dark pb-0 overflow-hidden" style="background-image: url(../Content/Home/assets/img/vector/16.png); background-color: #262a37;">
    <div class="overlay opacity-95" style="background-color: #262a37;"></div>
    <canvas class="constellation" data-color="rgba(255,255,255,0.3)"></canvas>
    <div class="container text-center">
        <div class="row align-items-center h-100">
            <div class="col-md-8 mx-auto">
                <h1>Boost your business's efficiency with iRestaurant</h1>
                <p class="lead mt-4 mb-7">A multi-platform order tracking and optimization system for restaurants, cafes and hotels.</p>
            </div>
            <div class="col-12 align-self-end text-center">
                <a class="scroll-down-3 scroll-down-white" href="#info"><span></span></a>
            </div>
            <div class="col-md-8 mx-auto align-self-end">
                <img src="../Content/Home/assets/img/preview/laptop-2.png" alt="img" data-aos="fade-up">
            </div>
        </div>
    </div>
</header><!-- /.header -->
<!-- Main Content -->
<main class="main-content">
    <!-- INFO -->
    <section class="section" id="info" style="background-image: linear-gradient(135deg, #f9f7ff 0%, #fff 50%, #f6f3ff 100%);">
        <div class="container">
            <div class="row align-items-center h-100">
                <div class="col-md-5">
                    <h1>Make your <span class="text-warning">restaurant</span>, <span class="text-info">hotel</span> or <span class="text-danger">cafe</span> <br> more efficient.</h1>
                    <p class="lead mt-5 mb-8">Based on the orders taken on your company's and branches' waiter and table tablets, monitor staff performance, product sales and stock levels in real time from your computer or mobile device, for any time period you choose. <br>Sign up now and enjoy a 30-day free trial.</p>
                    <a class="btn btn-round btn-primary" href="#howitworks">Learn more</a>
                    <a class="btn btn-round btn-outline-secondary ml-3" href="/Home/Register">Try it now</a>
                </div>
                <div class="col-md-6 ml-auto">
                    <img src="../Content/Home/assets/img/vector/17.png" alt="img">
                </div>
            </div>
        </div>
    </section>
    <!-- /.INFO -->
    
    <!-- HOW IT WORKS -->
    <section class="section" id="howitworks">
        <div class="container">
            <h1>How It Works</h1>
            <div class="row gap-y align-items-center py-7">
                <div class="col-md-6 text-center">
                    <img src="../Content/Home/assets/img/vector/1.png" alt="...">
                </div>
                <div class="col-md-5 ml-auto text-center text-md-left">
                    <p class="lead-9 fw-900 lh-1 opacity-10">01</p>
                    <h3>Sign up with your business details.</h3>
                    <p>First, register the company that owns your business. After verifying your email, log in to your panel and start your 30-day free trial.</p>
                </div>
            </div>
            <div class="row gap-y align-items-center py-7">
                <div class="col-md-5 mr-auto text-center text-md-left">
                    <p class="lead-9 fw-900 lh-1 opacity-10">02</p>
                    <h3>Create Your Branches</h3>
                    <p>Create your business's branches and assign your managers. Add your menus along with their product categories, products, extras and product options. Set up your floors/areas and tables.</p>
                </div>
                <div class="col-md-6 text-center order-first order-md-last">
                    <img src="../Content/Home/assets/img/vector/2.png" alt="...">
                </div>
            </div>
            <div class="row gap-y align-items-center py-7">
                <div class="col-md-6 text-center">
                    <img src="../Content/Home/assets/img/vector/3.png" alt="...">
                </div>
                <div class="col-md-5 ml-auto text-center text-md-left">
                    <p class="lead-9 fw-900 lh-1 opacity-10">03</p>
                    <h3>Assign licenses to your branches</h3>
                    <p>Enjoy your 30-day free trial! Then check out our flexible plans to license each of your branches. Buy monthly or yearly license packages to fit each branch's needs. If you're not satisfied, you can cancel your licenses within 7 days.*</p>
                </div>
            </div>
            <div class="row gap-y align-items-center py-7">
                <div class="col-md-5 text-center text-md-left">
                    <p class="lead-9 fw-900 lh-1 opacity-10">04</p>
                    <h3>Customer support is here for you</h3>
                    <p>As with any software, you may run into issues or tough decisions along the way. Whenever that happens, Live Chat in your Company Panel is always there for you. Where possible, we are also happy to support our valued customers in person.</p>
                </div>
                <div class="col-md-6 ml-auto text-center order-first order-md-last">
                    <img src="../Content/Home/assets/img/vector/4.png" alt="...">
                </div>
            </div>
            <div class="row gap-y align-items-center py-7">
                <p>* If you bought a license for the wrong branch, there's no need to request a refund. You can reassign the license to another branch from the Licenses tab in your company management panel.</p>
            </div>
        </div>
    </section>
    <!-- /.HOW IT WORKS -->

    <!-- CONTACT -->
    <section class="section py-0" id="contact">
        <div class="row no-gutters">
            <div class="col-md-6 align-self-center py-8">
                <h4 class="text-center">Write to us</h4>
                <br>
                <div class="row">
                    <div class="col-11 col-md-10 mx-auto">
                        <form class="bg-gray p-6" action="/Home/Contact" method="POST" enctype="application/x-www-form-urlencoded">
                            @{
                                if (ViewBag.message != null)
                                {
                                    <div class="alert alert-success d-on-success">@ViewBag.message</div>
                                }
                            }
                            <div class="form-group">
                                <input class="form-control form-control-lg" type="text" name="name" placeholder="Full name">
                            </div>
                            <div class="form-group">
                                <input class="form-control form-control-lg" type="email" name="email" placeholder="Email address">
                            </div>
                            <div class="form-group">
                                <textarea class="form-control form-control-lg" style="resize:none;" rows="4" placeholder="Your message" name="message"></textarea>
                            </div>
                            <button class="btn btn-lg btn-block btn-primary" type="submit">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="h-100" style="min-height: 300px" data-provide="map" data-lat="44.540" data-lng="-78.556" data-marker-lat="44.540" data-marker-lng="-78.556" data-info="&lt;strong&gt;Our office&lt;/strong&gt;&lt;br&gt;3652 Seventh Avenue, Los Angeles, CA" data-style="light"></div>
            </div>
        </div>
    </section>
