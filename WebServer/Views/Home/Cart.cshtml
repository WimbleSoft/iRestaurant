@{ 
    Layout = "~/Views/Shared/home_Layout.cshtml";
    ViewBag.Title = "Cart";
    int currencyId = 0;
    if (Session["currencyId"] == null)
    {
        currencyId = 1;
    }
    else
    {
        if ((int)Session["currencyId"] > 0 && (int)Session["currencyId"] <= 4)
        {
            currencyId = (int)Session["currencyId"];
        }
        else
        {
            currencyId = 1;
        }
    }
}
@model  iRestaurant.Controllers.ViewModelDemoVM
    <!-- Main Content -->
<main class="main-content">
    <!-- Header -->
    <header class="header bg-gray" style="margin-bottom:55px !important; padding-bottom:45px !important;">
        <div class="container">
            <h1 class="display-4">Cart Overview</h1>
            <p class="lead-2 mt-6">Review your cart and make sure you have everything you need.</p>
        </div>
    </header><!-- /.header -->
    <section class="section" style="padding-top:unset !important;">
        <div class="container">
            <div class="row gap-y">
                @if (Model.CartServices.Count > 0)
                {
            <div class="col-lg-8">
                <table class="table table-cart">
                    <tbody valign="middle">
                    @foreach (var item in Model.CartServices.Where(x => x.serviceCampaignId != null).GroupBy(x=>x.serviceCampaignId))
                    {
                        <tr id="campaignRow_@item.Key">
                            <td>
                                <form action="/Home/RemoveCampaignFromCart" method="post" enctype="application/x-www-form-urlencoded">
                                    <input hidden="hidden" type="text" name="yearly" value="@Model.CartServices.Where(x=>x.serviceCampaignId == item.Key).First().isYearly.ToString()" />
                                    <input hidden="hidden" type="text" name="serviceCampaignId" value="@item.Key" />
                                    <button class="item-remove" type="submit"><i class="ti-close"></i></button>
                                </form>
                            </td>
                            <td>
                                <h5>@Model.ServiceCampaigns.Where(x => x.serviceCampaignId == item.Key).First().serviceCampaignName</h5>
                                <p>
                                    @{
                                        if (Model.CartServices.Where(x => x.serviceCampaignId == item.Key).First().isYearly)
                                        {
                                            <text>Yearly</text>
                                        }
                                        else
                                        {
                                            <text>Monthly</text>
                                        }
                                    }
                                    
                                       Campaign
                                </p>
                            </td>
                            <td>
                                <label>Quantity</label>
                                <input class="form-control form-control-sm" id="quantityCampaign_@Model.CartServices.Where(x=>x.serviceCampaignId == item.Key).First().serviceCampaignId" type="text" placeholder="Quantity" onchange="return changeCartServiceCampaignQuantity(@Model.CartServices.Where(x=>x.serviceCampaignId == item.Key).First().serviceCampaignId)" value="@Model.CartServices.Where(x=>x.serviceCampaignId == item.Key).First().quantity" />
                            </td>
                            <td>
                                 <h4 class="price" >
                                    @{ 
                                        ServiceCampaigns serviceCampaign = Model.ServiceCampaigns.Where(x => x.serviceCampaignId == item.Key).First();
                                        if (serviceCampaign != null)
                                        {
                                    
                                                <span id="feeCampaign_@Model.CartServices.Where(x=>x.serviceCampaignId == item.Key).First().serviceCampaignId">@(serviceCampaign.serviceCampaignPrice)</span>
                                            
                                        }
                                        else
                                        {
                                            <meta http-equiv="refresh" content="0; url=/Home/Error404" />
                                        }
                                    }

                                    @{
                                        if (Model.ServiceCampaigns.Where(y => y.serviceCampaignId == item.Key).First().Currencies != null)
                                        {
                                            <span>
                                                @Model.ServiceCampaigns.Where(y => y.serviceCampaignId == item.Key).First().Currencies.currencyName
                                            </span>
                                        }
                                        else
                                        {
                                        <span>
                                            <meta http-equiv="refresh" content="0; url=/Home/Error404" />
                                        </span>
                                        }
                                    }
                                 </h4>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.CartServices.Where(x => x.serviceCampaignId == null))
                    {
                        <tr>
                            <td>
                                <form action="/Home/RemoveItemFromCart" method="post" enctype="application/x-www-form-urlencoded">
                                    <input hidden="hidden" type="number" name="serviceId" value="@item.serviceId" />
                                    <input hidden="hidden" type="text" name="yearly" value="@item.isYearly.ToString()" />
                                    <button class="item-remove" type="submit"><i class="ti-close"></i></button>
                                </form>
                            </td>
                            <td>
                                <h5>@item.serviceName</h5>
                                <p>
                                    @{
                                        if (item.isYearly)
                                        {
                                            <text>Yearly</text>
                                        }
                                        else
                                        {
                                            <text>Monthly</text>
                                        }
                                    }
                                    
                                </p>
                            </td>
                            <td>
                                <label>Quantity</label>

                                <input hidden="hidden" type="text" id="yearlyItem_@item.serviceId" value="@item.isYearly.ToString()" />
                                <input class="form-control form-control-sm" id="quantityItem_@item.serviceId" type="text" placeholder="Quantity" onchange="return changeCartServiceQuantity(@item.serviceId)" value="@item.quantity" />
                            </td>
                            <td>
                                 <h4 class="price" id="feeItem_@item.serviceId">
                                    
                                        @if (item.isYearly)
                                        {
                                            <span>@(item.serviceMonthlyFee * 12)</span>
                                        }
                                        else
                                        {
                                            <span>
                                                @item.serviceMonthlyFee
                                            </span>
                                        }
                                    
                                    @{
                                        if (Model.Currencies.Where(x => x.currencyId == item.currencyId).Count() > 0)
                                        {
                                            <span>
                                                @Model.Currencies.Where(x => x.currencyId == item.currencyId).First().currencyName
                                            </span>
                                        }
                                        else
                                        {
                                        <span>
                                            0
                                        </span>
                                        }
                                    }
                                 </h4>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="col-lg-4">
                <div class="cart-price">
                    <div class="flexbox">
                        <div>
                            <p><strong>Subtotal:</strong></p>
                            <p><strong>VAT (18%):</strong></p>
                        </div>
                        <div>
                            <p id="subtotal">
                                @{
                                    double subtotal = (Model.CartServices.Where(x => x.isYearly == true && x.serviceCampaignId == null).Sum(x => x.serviceMonthlyFee * x.quantity) * 12)+
                                      Model.CartServices.Where(x => x.isYearly == false && x.serviceCampaignId == null).Sum(x => x.serviceMonthlyFee * x.quantity);

                                    double subtotal2 = 0;
                                    foreach(var serviceCampaign in Model.CartServices.Where(x =>x.serviceCampaignId != null).GroupBy(x => x.serviceCampaignId))
                                    {
                                        subtotal2+= Model.ServiceCampaigns.Where(x => x.serviceCampaignId == serviceCampaign.Key.Value).First().serviceCampaignPrice* Model.CartServices.Where(x => x.serviceCampaignId == serviceCampaign.Key.Value).First().quantity;
                                    }
                                    }
                                @(subtotal+subtotal2)
                                @Model.Currencies.Where(x => x.currencyId == currencyId).First().currencyName
                            </p>
                            <p id="vatAmount">
                                @((subtotal+subtotal2) * 0.18) 
                                @Model.Currencies.Where(x => x.currencyId == currencyId).First().currencyName
                            </p>
                        </div>
                    </div>
                    <hr>
                    <div class="flexbox">
                        <div>
                            <p><strong>Total:</strong></p>
                        </div>
                        <div>
                            <p class="fw-600" id="total">@((subtotal+subtotal2) * 1.18) @Model.Currencies.Where(x => x.currencyId == currencyId).First().currencyName</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <a class="btn btn-block btn-secondary" href="/Home/Pricing">Continue Shopping</a>
                    </div>
                    <div class="col-6">
                        <a class="btn btn-block btn-primary" href="/Home/Checkout">Checkout <i class="ti-angle-right fs-9"></i></a>
                    </div>
                </div>
            </div>
}
else
{
            <div class="col-md-3">
                
            </div>
            <div class="col-md-6">
                <a class="btn btn-lg btn-light btn-round btn-outline-success" href="/Home/Pricing">Your cart is empty. Click here to see our plans.</a>
            </div>
            <div class="col-md-3">
                
            </div>
}

            </div>
        </div>
    </section>
</main><!-- /.main-content -->
    <!-- Footer -->
<script>
    function cartRecalculate() {
        var total = 0;
        var subtotal = 0;
        var vatAmount = 0;
        function ShowResultsItem(value, index, ar) {//EXPERIMENTAL
            
            var fee = parseFloat(document.getElementById('feeItem_' + value.value).innerHTML);
            var quantity = parseFloat($("#quantityItem_" + value.value).val());
            var isYearly = parseFloat($("#yearlyItem_" + value.value).val());
            if (isYearly == "True") {
                subtotal += fee * 12 * quantity;
                vatAmount = subtotal * 0.18;
                total = subtotal + vatAmount;
            }
            else {
                subtotal += fee * quantity;
                vatAmount = subtotal * 0.18;
                total = subtotal + vatAmount;
            }
            
        }
        function ShowResultsCampaign(value, index, ar) {

            var fee = parseFloat(document.getElementById('feeCampaign_' + value.value).innerHTML);
            var quantity = parseFloat($("#quantityCampaign_" + value.value).val());
            subtotal += fee * quantity;
            vatAmount = subtotal * 0.18;
            total = subtotal + vatAmount;

        }

        var input = document.getElementsByName("serviceId");//EXPERIMENTAL
        var inputList = Array.prototype.slice.call(input);//EXPERIMENTAL
        var input2 = document.getElementsByName("serviceCampaignId");
        var inputList2 = Array.prototype.slice.call(input2);
        //alert(inputList.length);//EXPERIMENTAL
        inputList.forEach(ShowResultsItem);//EXPERIMENTAL
        //alert(inputList2.length);
        inputList2.forEach(ShowResultsCampaign);

        document.getElementById("vatAmount").innerHTML = vatAmount.toFixed(2) + " @Model.Currencies.Where(x => x.currencyId == currencyId).First().currencyName";
        document.getElementById("subtotal").innerHTML = subtotal.toFixed(2) + " @Model.Currencies.Where(x => x.currencyId == currencyId).First().currencyName";
        document.getElementById("total").innerHTML = total.toFixed(2) + " @Model.Currencies.Where(x => x.currencyId == currencyId).First().currencyName";
    }
    function changeCartServiceQuantity(serviceId) {//EXPERIMENTAL
        var quantity = document.getElementById('quantity_' + serviceId).value;
        var yearly = document.getElementById('yearly_' + serviceId).value;
        if (serviceId != "" && quantity != null && yearly != null) {
            $.ajax({
                type: 'POST',
                url: '/Home/ChangeItemQuantityFromCart/',
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                data: JSON.stringify({ serviceId: serviceId, yearly: yearly, quantity: quantity }),
                success: function (data) {
                    if (data == 0) {

                        cartRecalculate();
                    }
                    else if (data == 1) {
                        alertError();
                        location.reload(true);
                    }
                    else if (data == 2) {
                        alert('This item is not in your cart.');
                        location.reload(true);
                    }
                    else if (data == -1){
                        alertLoginError();
                        location.reload(true);
                    }
                }
            });
        }
        else {
            alertFillFields();
        }
    }
    function changeCartServiceCampaignQuantity(serviceCampaignId) {
        var quantity = document.getElementById('quantityCampaign_' + serviceCampaignId).value;
        if (serviceCampaignId != "" && quantity != null) {
            $.ajax({
                type: 'POST',
                url: '/Home/ChangeCampaignQuantityFromCart/',
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                data: JSON.stringify({ serviceCampaignId: serviceCampaignId, quantity: quantity }),
                success: function (data) {
                    if (data == 0) {
                        if (quantity==0)
                        $("#campaignRow_" + serviceCampaignId).remove();
                        cartRecalculate();
                    }
                    else if (data == 1) {
                        alertError();
                        location.reload(true);
                    }
                    else if (data == 2) {
                        alert('This item is not in your cart.');
                        location.reload(true);
                    }
                    else if (data == 3) {
                        alert('Your cart is empty.');
                        location.reload(true);
                    }
                }
            });
        }
        else {
            alertFillFields();
        }
    }


    function addItemToSession(serviceId) {

        if (serviceId != "" && quantity != "" && yearly != "", serviceCampaignId !="") {
            $.ajax({
                type: 'POST',
                url: '/Home/ItemQuantityChange/',
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                data: JSON.stringify({ serviceId: serviceId, quantity: quantity, yearly: yearly, serviceCampaignId: serviceCampaignId }),
                success: function (data) {
                    if (data == 0) {
                        //location.reload(true);
                    }
                    else if (data == 1) {
                        alertError();
                    }
                    else if (data == -1) {
                        alertLoginError();
                    }
                }
            });
        }
        else {
            alertFillFields();
        }
    }
</script>