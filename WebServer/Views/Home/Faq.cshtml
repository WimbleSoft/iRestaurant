@{ 
    Layout = "~/Views/Shared/home_Layout.cshtml";
}

    <!-- Main Content -->
    <main class="main-content">
        <!-- FAQ -->
        <section class="section">
            <div class="container">
                <header class="section-header">
                    <small>FAQ</small>
                    <h2>Frequently Asked Questions</h2>
                    <hr>
                    <p>Got questions? We have answers. If your question isn't covered below, please get in touch through our Contact page.</p>
                </header>

                <div class="row">
                    <div class="col-md-8 mx-auto">
                        <div class="accordion accordion-connected border" id="accordion-1">
                            <div class="card">
                                <h5 class="card-title">
                                    <a class="collapsed" data-toggle="collapse" href="#collapse-1-1">Is this site secure for purchases?</a>
                                </h5>
                                <div id="collapse-1-1" class="collapse" data-parent="#accordion-1">
                                    <div class="card-body">
                                        Absolutely! We work with leading payment companies that guarantee your safety and security. All billing information is stored with our payment processing partner, which holds the most stringent level of certification available in the payments industry.
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <h5 class="card-title">
                                    <a class="collapsed" data-toggle="collapse" href="#collapse-1-2">How long are your contracts?</a>
                                </h5>
                                <div id="collapse-1-2" class="collapse" data-parent="#accordion-1">
                                    <div class="card-body">
                                        We currently offer monthly and yearly subscriptions. You can upgrade or cancel your monthly account at any time with no further obligation.
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <h5 class="card-title">
                                    <a class="collapsed" data-toggle="collapse" href="#collapse-1-3">Can I cancel my subscription?</a>
                                </h5>
                                <div id="collapse-1-3" class="collapse" data-parent="#accordion-1">
                                    <div class="card-body">
                                        You can cancel your subscription from your account at any time. Once it is cancelled, you will not be charged for the next month or year. You will keep access to your account until your current subscription expires.
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <h5 class="card-title">
                                    <a class="collapsed" data-toggle="collapse" href="#collapse-1-4">Can I request a refund?</a>
                                </h5>
                                <div id="collapse-1-4" class="collapse" data-parent="#accordion-1">
                                    <div class="card-body">
                                        Refund requests must be made within 7 days of purchase. After that, we do not issue full or partial refunds.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- /.FAQ -->



    </main><!-- /.main-content -->
    <!-- Footer -->
    