@{
    Layout = "~/Views/Shared/home_Layout.cshtml";
    ViewBag.Title = "Pricing";
    int currencyId = 0;
    if (Session["currencyId"] == null)
    {
        currencyId = 1;
    }
    else
    {
        if((int)Session["currencyId"]>0 && (int)Session["currencyId"] <= 4)
        {
            currencyId = (int)Session["currencyId"];
        }
        else
        {
            currencyId = 1;
        }
    }
}
@model iRestaurant.Controllers.ViewModelDemoVM
<!-- Main Content -->
<main class="main-content">
    <!-- PRICING -->
    <section class="section overflow-hidden bg-gray" id="pricing">
        <div class="container">
            <header class="section-header">
                <small>Pricing</small>
                <h2>Choose the best plan for your branch</h2>
                <hr>
                <p class="lead">Pick a plan for each of your branches. Our flexible plans let you choose what fits each branch best.</p>
            </header>

            <div data-provide="shuffle">
                <ul class="nav nav-tabs-outline nav-center nav-bold nav-uppercase nav-pills mb-7" data-shuffle="filter">
                    <li class="nav-item">
                        <a class="nav-link active" href="#" data-shuffle="button">All</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-shuffle="button" data-group="monthly">Monthly</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-shuffle="button" data-group="yearly">Yearly</a>
                    </li>
                </ul>
                <div class="row gap-y text-center gap-2" data-shuffle="list">
                    @foreach (var serviceCampaign in Model.ServiceCampaigns.Where(x => x.isYearly == false && x.currencyId == currencyId))
                    {
                    <div class="col-3 col-md-3" data-shuffle="item" data-groups="monthly">
                        <div class="pricing-1">
                            <p class="plan-name">@serviceCampaign.serviceCampaignName</p>
                            <br>
                            <h2 class="price">@(serviceCampaign.serviceCampaignPrice*1.18) @serviceCampaign.Currencies.currencyName</h2>
                            <p class="small">&nbsp;</p>
                            <div class="col-md-9 col-md-offset-3">
                                <div class="text-muted text-left">
                                    @foreach (var serviceCampaignService in Model.ServiceCampaignServices.Where(x => x.serviceCampaignId == serviceCampaign.serviceCampaignId))
                                    {
                                        <small><i class="fa fa-check-square-o"></i> @serviceCampaignService.Services.serviceName</small><br>
                                    }
                                        <small><i class="fa fa-check-square-o"></i> Pause subscription </small><br>
                                </div>
                            </div>
                            <br>
                            <form action="/Home/AddCampaignToCart" method="post" enctype="application/x-www-form-urlencoded">
                                <input name="serviceCampaignId" value="@serviceCampaign.serviceCampaignId" hidden="hidden" />
                                <p class="text-center py-3"><button class="btn btn-primary" type="submit">Add to Cart</button></p>
                            </form>
                        </div>
                    </div>
                    }
                    @foreach (var serviceCampaign in Model.ServiceCampaigns.Where(x => x.isYearly == true && x.currencyId == currencyId))
                    {
                
                        <div class="col-3 col-md-3" data-shuffle="item" data-groups="yearly">
                            <div class="pricing-1">
                                <p class="plan-name">@serviceCampaign.serviceCampaignName</p>
                                <br>
                                <h2 class="price">@(serviceCampaign.serviceCampaignPrice * 1.18) @serviceCampaign.Currencies.currencyName</h2>
                                <p class="small">&nbsp;</p>
                                <div class="col-md-9 col-md-offset-3">
                                    <div class="text-muted text-left">
                                        @foreach (var serviceCampaignService in Model.ServiceCampaignServices.Where(x => x.serviceCampaignId == serviceCampaign.serviceCampaignId))
                                        {
                                            <small><i class="fa fa-check-square-o small"></i> @serviceCampaignService.Services.serviceName</small><br>
                                        }
                                        <small><i class="fa fa-times-circle"></i> Pause subscription</small><br>
                                    </div>
                                </div>
                                <br>
                                <form action="/Home/AddCampaignToCart" method="post" enctype="application/x-www-form-urlencoded">
                                    <input name="serviceCampaignId" value="@serviceCampaign.serviceCampaignId" hidden="hidden" />
                                    <p class="text-center py-3"><button class="btn btn-primary" type="submit" >Add to Cart</button></p>
                                </form>
                            </div>
                        </div>
                
                    }
                </div>
            </div>
        </div>
    </section>
    <!-- /.PRICING -->



</main><!-- /.main-content -->
<!-- Footer -->