<script>
    var branchId = "@Session["branchId"]";
    var companyId = "@Session["companyId"]";
    function alertError() {
        alert("An error occurred. A report has been sent to our support team.");
    }
    function alertLoginError() {
        alert("You must be logged in to do this. Please contact your application administrator.");
        location.href = "/BranchAdmin/Login/"
    }
    function alertFillFields() {
        alert("Please fill in the required fields.");
    }
    function alertOperationCancelled() {
        alert("Operation cancelled.");
    }
</script>

<script>
function updateSettings(item) {
    var array = item.split('_');
    var employeeName = $('#employeeName_id_' + array[2]);
    var employeePassword = $('#employeePassword_id_' + array[2]);
    var employeeEmail = $('#employeeEmail_id_' + array[2]);
    var employeePhone = $('#employeePhone_id_' + array[2]);
    if (employeeName != "" && employeeEmail != "" && employeePhone !=""){
        $.ajax({
            url: '/BranchAdmin/UpdateSettings',
            type: 'POST',
            dataType: 'json',
            contentType: "application/json",
            data: JSON.stringify({ employeeName: employeeName, employeePassword: employeePassword, employeeEmail: employeeEmail, employeeId: array[2], employeePhone: employeePhone }),
            success: function (data) {
                if (data == 2) {
                    alert("Your password must be between 8 and 20 characters long.")
                }
                else if (data == 0) {
                    window.location.reload();
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
    else {
        alertFillFields();
    }
    
}
</script>
