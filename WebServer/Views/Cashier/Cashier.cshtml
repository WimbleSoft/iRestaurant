    function print(toPrint,paymentTypeId) {
        $.ajax({
            cache: false
        });

        var toPrintTableSessionId = parseInt(toPrint.name);
        var tableSessionId = toPrintTableSessionId;
        var realPaymentAmount = $('#subtotal_' + toPrintTableSessionId).val();
        if (realPaymentAmount == 0) {
            alert("You have not selected anything.");
        }
        else {

            var paymentAmountArray = realPaymentAmount.split('.');
            var paymentAmount = parseInt(paymentAmountArray[0]) + ',' + parseInt(paymentAmountArray[1]);

            var withoutExtrasOrderProducts = []; // Holds the orderProductIds.
            var orderProductCount = [];// Holds how many of each item are being paid for.
            var withoutExtras = [];
            var withExtrasCheckboxValuesArray = []; // Holds the checkbox values of items with extras.
            var campaignCheckboxValuesArray = []; // Holds the checkbox values of campaign items.
            var isRenewable = false;
            var withoutExtrasPaid=false;
            var withExtrasPaid=false;
            var campaignPaid=false;
            $(document.getElementsByName('WithoutExtras_' + toPrintTableSessionId + '_quantity')).each(function (item) {

                var select = $(this).attr('orderProductIds');
                withoutExtras.push({ orderQuantity: $(this).val(), productOptionId: select, tableSessionId: toPrintTableSessionId });
            });
            $(document.getElementsByName('WithExtras_check_' + toPrintTableSessionId)).each(function () {
                var arr = $(this).val().split('_');
                var checked = $('#tableSessionId_' + toPrintTableSessionId + '_orderProductId_' + arr[3]).is(':checked');
                if (checked == true) {
                    withExtrasCheckboxValuesArray.push({ orderProductId: arr[3] });
                }
            });
            $(document.getElementsByName('Campaign_check_' + toPrintTableSessionId)).each(function () {
                var arr2 = $(this).val().split('_');
                var checked = $('#tableSessionId_' + toPrintTableSessionId + '_tableSessionCampaignId_' + arr2[1]).is(':checked');
                if (checked == true) {
                    campaignCheckboxValuesArray.push({ tableSessionCampaignId: arr2[1] });
                }
            });

            // Chained POSTs: record the payment, then settle items with extras, items without extras and campaigns in turn
            $.ajax({
                type: 'POST',
                url: '/Cashier/TakePayment/',
                dataType: 'json',
                data: { tableSessionId: tableSessionId, paymentAmount: paymentAmount, paymentTypeId: paymentTypeId, branchId: branchId },
                success: function(){
                    try{
                        // Items with extras
                        $.ajax({
                            url: "/Cashier/WithExtrasCheckboxValuesArrayHandler",
                            type: "POST",
                            dataType: "json",
                            contentType: "application/json",
                            data: JSON.stringify({ withExtrasCheckboxValuesArray: withExtrasCheckboxValuesArray, tableSessionId: tableSessionId, branchId: branchId}),
                            success:function(data1){
                                if(data1==true){
                                    withExtrasPaid=true;
                                    // Items without extras
                                    $.ajax({
                                        url: "/Cashier/WithoutExtrasHandler",
                                        type: "POST",
                                        dataType: "json",
                                        contentType: "application/json",
                                        data: JSON.stringify({ withoutExtras, tableSessionId: tableSessionId, branchId: branchId}),
                                                success:function(data2){
                                                    if(data2==true){
                                                        withoutExtrasPaid=true;
                                                        // Campaign items
                                                        $.ajax({
                                                            url: "/Cashier/CampaignCheckboxValuesArrayHandler",
                                                            type: "POST",
                                                            dataType: "json",
                                                            contentType: "application/json",
                                                            data: JSON.stringify({ campaignCheckboxValuesArray, tableSessionId: tableSessionId, branchId: branchId}),
                                                            success: function (data3) {
                                                                if(data3==true){
                                                                    campaignPaid=true;
                                                                    try{
                                                                        //if(withExtrasPaid&&withoutExtrasPaid&&campaignPaid){
                                                                        $.ajax({
                                                                            url: "/Cashier/IsFullyPaid",
                                                                            type: "POST",
                                                                            async:false,
                                                                            dataType: "json",
                                                                            data: {tableSessionId:tableSessionId},
                                                                            success: function (isFullyPaid) {
                                                                                if (isFullyPaid == true) {
                                                                                    //setInterval(function () {
                                                                                    location.reload(true);

                                                                                    //}, 3000);
                                                                                }
                                                                                else {
                                                                                    getTableSessionDetail(tableSessionId);
                                                                                }

                                                                            }
                                                                        });
                                                                        //}
                                                                    }catch(error){

                                                                        console(error.message);

                                                                    };
                                                                }
                                                            }
                                                        });
                                                    }
                                                }
                                    });
                                }

                            }
                        });
                    }
                    catch(error){
                        console(error.message);
                    };
                }
            });

            /*
            // Prints a receipt for every individual payment. If this is enabled, the print-all in IsFullyPaid must be disabled.
            $.ajax({
                url: "/Cashier/PrintReceipt",
                type: "POST",
                dataType: "json",
