    function logout() {
        var employeeId = @Session["loggedInEmployeeId"];
        var employeePassword = $('#employeePassword').val();
        if (employeeId != "" && employeePassword != "") {
            $.ajax({
                type: 'POST',
                url: '/Cashier/CheckLogout/',
                dataType: 'json',
                data: { employeeId: employeeId, employeePassword: employeePassword, branchId: branchId },
                success: function (data2) {
                    if (data2 == 0) {
                        location.href = "/Cashier/Login";
                    }
                    else if (data2 == 1) {
                        alert("Incorrect manager password.");
                    }
                    else if (data2 == 2) {
                        alert("You have been temporarily locked out due to too many failed attempts.");
                    }
                    else {

