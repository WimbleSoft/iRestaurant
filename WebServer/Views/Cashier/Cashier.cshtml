<script>
    setInterval(function refreshTable() {
        if ($("#body").attr("class") != "modal-open") {
            $.ajax({
                type: "POST",
                url: "/Cashier/Tables",
                dataType: "json",
                async: false,
                data: { tableSessionId: 0, branchId: branchId },
                success: function (data) {
                    if (data) {
                        $("#tableList").empty();
                        $('#tableList').html(data.responseText);
                    }
                    else {
                        alert("Could not be loaded in time.");
                    }
                },
                error: function (data) {
                    if (data) {
                        $("#tableList").empty();
                        $('#tableList').html(data.responseText);
                    }
                    else {
                        alert("Could not be loaded in time.");
                    }
                }
            });
