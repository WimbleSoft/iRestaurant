    function calculate(tableSessionId) {
        var withoutExtrasTotal = 0;
        var withExtrasTotal = 0;
        var campaignsTotal = 0;

        $(document.getElementsByClassName('WithoutExtras_' + tableSessionId)).each(function (item) {
            var withoutExtrasPriceArray = $(this).val().split(',');
            var withoutExtrasPrice = "";
            if (withoutExtrasPriceArray[1] == null) {
                withoutExtrasPrice = withoutExtrasPriceArray[0];
            }
            else {
                withoutExtrasPrice = parseInt(withoutExtrasPriceArray[0]) + '.' + parseInt(withoutExtrasPriceArray[1]);
            }
            withoutExtrasTotal += parseFloat(withoutExtrasPrice);

        });
        $(document.getElementsByClassName('withExtras_subtotal_'+tableSessionId)).each(function () {
            var arr = $(this).val().split('_');
            var checked = $('#tableSessionId_' + tableSessionId + '_orderProductId_' + arr[3]).is(':checked');
            if (checked == true) {
                var productPriceArray = $('#WithExtras_value_tableSessionId_' + tableSessionId + '_orderProductId_' + arr[3]).val().split(',');
                var productPrice = "";
                if (productPriceArray[1] == null) {
                    productPrice = productPriceArray[0];
                }
                else {
                    productPrice = parseInt(productPriceArray[0]) + '.' + parseInt(productPriceArray[1]);
                }
                withExtrasTotal += parseFloat(productPrice);
            }
        });
        $(document.getElementsByClassName('campaigns_subtotal_' + tableSessionId)).each(function () {
            var arr2 = $(this).val().split('_');
            var checked2 = $('#tableSessionId_' + tableSessionId +'_tableSessionCampaignId_' + arr2[1]).is(':checked');
            if (checked2 == true) {
                var campaignPriceArray = $('#Campaign_value_tableSessionId_' + tableSessionId + '_tableSessionCampaignId_' + arr2[1]).val().split(',');
                var campaignPrice = "";
                if (campaignPriceArray[1] == null) {
                    campaignPrice = campaignPriceArray[0];
                }
                else {
                    campaignPrice = parseInt(campaignPriceArray[0]) + '.' + parseInt(campaignPriceArray[1]);
                }
                campaignsTotal += parseFloat(campaignPrice);
            }
        });
        $('#subtotal_' + tableSessionId).val(parseFloat(withExtrasTotal + withoutExtrasTotal + campaignsTotal).toFixed(2));

    }
