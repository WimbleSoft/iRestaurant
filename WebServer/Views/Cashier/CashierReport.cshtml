<div class="row" style="margin-left:0px !important; margin-right:0px !important;">
    <div class="col-lg-12" style="background-color:#222222; text-align:center;">
        <table style="background-color:#222222; text-align:center;">
            <tbody>
                <tr>
                    <td style="color:white; text-align:center;"><i>Revenue Report for Selected Dates</i></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="row btn-metis-3" style="margin-left:0px !important; margin-right:0px !important; text-align:center; font-size:22px;">
    @if (Model.PaymentTypes[0] != null)
    {
        <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@Model.PaymentTypes[0].paymentTypeName</div>
    }
    @if (Model.PaymentTypes[1] != null)
    {
        <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@Model.PaymentTypes[1].paymentTypeName</div>
    }
    @if (Model.PaymentTypes[2] != null)
    {
        <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@Model.PaymentTypes[2].paymentTypeName</div>
    }
    @if (Model.PaymentTypes[3] != null)
    {
        <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@Model.PaymentTypes[3].paymentTypeName</div>
    }
    @if (Model.PaymentTypes[4] != null)
    {
        <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@Model.PaymentTypes[4].paymentTypeName</div>
    }
    @if (Model.PaymentTypes[5] != null)
    {
        <div class="col-md-2 col-lg-2">@Model.PaymentTypes[5].paymentTypeName</div>
    }
</div>
<div class="row btn-metis-5" style="margin-left:0px !important; margin-right:0px !important; text-align:center;  font-size:20px;">
    <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@ViewBag.PaymentType0 @ViewBag.PaymentTypeCurrency0</div>
    <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@ViewBag.PaymentType1 @ViewBag.PaymentTypeCurrency1</div>
    <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@ViewBag.PaymentType2 @ViewBag.PaymentTypeCurrency2</div>
    <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@ViewBag.PaymentType3 @ViewBag.PaymentTypeCurrency3</div>
    <div class="col-md-2 col-lg-2" style="border-right:1px solid cyan;">@ViewBag.PaymentType4 @ViewBag.PaymentTypeCurrency4</div>
    <div class="col-md-2 col-lg-2">                                     @ViewBag.PaymentType5 @ViewBag.PaymentTypeCurrency5</div>
</div>
<div class="row" style="margin-top:15px; margin-bottom:15px; margin-left:0px !important; margin-right:0px !important;">
    <div class="col-lg-4">
    </div>
    <div class="col-lg-4">
        <a style="min-width:100%;" class="btn btn-grad btn-success" onclick="getReportJs()">Print</a>
    </div>
    <div class="col-lg-4">
    </div>
</div>