                                                    <div class="row" style="background-color:#9FC5F8; margin-left:0px !important; margin-right:0px !important;">
                                                        <div class="col-md-12" style="padding:0px !important; border-top:0px solid azure !important;">
                                                            <a id="changeOrderProductsStatus" class="btn btn-metis-5 btn-lg btn-grad" data-dismiss="modal" style="min-width:100%"><i class="fa fa-chevron-left"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.modal-content -->
                                        </div>
                                        <!-- /.modal-dialog -->
                                    </div>
                                </div>
                            <!-- /#helpModal -->
                                                        }
                            <!-- Each ordered item: end -->
                            <!-- Order note: start -->
                            <div class="row btn-grad btn-metis-6" style="width:100%; margin-left:0px !important; margin-right:0px !important;">
                                <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                                    <div class="col-md-3" style="padding-top:10px; padding-bottom:10px;">
                                        <span style="color:white;">Order Note:</span>
                                    </div>
                                </div>
                                <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                                    <div class="col-md-12" style="padding-top:10px; padding-bottom:10px; text-align:left;">
                                        <span style="color:white;">@item.note</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Order note: end -->
                            <!-- Undo confirmation of all items: start -->
                            <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                                <div class="col-md-12" style="padding-left:0px !important; padding-right:0px !important;">
                                    <a id="confirmAllOrderProducts_ID" onclick="XConfirmingAllOrderProducts(this.name)" name="@item.orderId" class="btn btn-danger btn-lg btn-grad" style="min-width:100%"><i class="fa fa-undo"></i></a>
                                </div>
                            </div>
                            <!-- Undo confirmation of all items: end -->

                        </div>
                    </div>
                </div>
             }
            <!-- Each order: end -->
        </div>
        <!-- Row of 4 orders: end -->
    </div>
</div>

<script type="text/javascript">
function changeOrderProductsStatus(orderProductsID) {
    $.ajax({
        url: '/Kitchen/ChangeOrderProductsStatus?orderProductId=' + orderProductsID,
        type: 'POST',
        dataType: 'json',
        success: function (data) {
            $("#OrderProductsStatus").html(data);
        }
    });
};
</script>
<script type="text/javascript">
    function XConfirmingAllOrderProducts(order_Id) {
    $.ajax({
        type: 'POST',
        url: '/Kitchen/ConfirmingAll?orderId=' + order_Id,
        dataType: 'json',
        success: function (data) {
            if (data) {
                window.location.replace("/Kitchen/CompletedOrders")
            };
        }
    });
};
</script>