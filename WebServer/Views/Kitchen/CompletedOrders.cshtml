@model  List<iRestaurant.Orders>

@{
    Layout = "~/Views/Shared/kitchen_Layout.cshtml";
    int counter = 0;
    int counter2 = 0;
    int counter3 = 0;
}


<div class="outer"style="height:inherit !important;background-color: #303030;">
    <div class="inner bg-dark lter">
        <!-- Row of 4 orders: start -->
        <div class="row">
            <!-- Each order: start -->
            @foreach (var item in Model.Where(x => x.orderStatus == true).Take(4).OrderBy(x => x.orderDate))
            {
                <div class="col-lg-3 ui-sortable">
                    <div class="box" style="position: relative; left: 0px; top: 0px; border:none !important;">
                        <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                            <!-- Floor / table / elapsed time row: start -->
                            <div class="row" style="margin-left:0px !important; margin-right:0px !important; background-color:azure;">
                                <table>
                                    <tbody>
                                        <tr>
                                            <td style="width:25%;">Floor: @item.TableSessions.Tables.Floors.floorName</td>
                                            <td style="width:25%;">Table: @item.TableSessions.Tables.tableName</td>
                                            <td style="width:10%;"></td>
                                            <td style="width:40%;">Ordered: @DateTime.Now.Subtract(item.orderDate).Hours h @DateTime.Now.Subtract(item.orderDate).Minutes min ago</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Floor / table / elapsed time row: end -->
                            <!-- Type / options header row: start -->
                            <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                                <div class="col-lg-12" style="background-color:cadetblue;">
                                    <table style="background-color:cadetblue;">
                                        <tbody>
                                            <tr>
                                                <td style="color:black" class="col-lg-3">Type</td>
                                                <td style="color:black" class="col-lg-3"></td>
                                                <td style="color:black" class="col-lg-3"></td>
                                                <td style="color:black" class="col-lg-3">Options</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!-- Type / options header row: end -->
                            <!-- Each ordered item: start -->
                            @foreach (var item2 in item.OrderProducts.Where(y => y.orderId == item.orderId))
                            {
                                counter++;
                                <div class="row  btn-grad @if (counter % 2 == 0){<text>btn-default</text>}else{<text>btn-metis-7</text>}" style="margin-left:0px !important; margin-right:0px !important;">
                                    <div class="col-md-8" style="padding-top:10px; padding-bottom:10px;">
                                        <span>@item2.Products.productName - @item2.ProductOptions.productOptionName</span>
                                    </div>
                                    <div class="col-md-4">
                                        <a class="btn btn-success btn-metis-3 btn-circle btn-grad" data-toggle="modal" data-original-title="Help" data-placement="bottom" href="#helpModal_@item2.orderProductId"><i class="fa fa-plus"></i></a>
                                    </div>
                                </div>
                            <!-- #helpModal -->
                                <div class="row">
                                    <div id="helpModal_@item2.orderProductId" class="modal fade">
                                        <div class="modal-dialog">
                                            <div class="modal-content"style="background-color:#ffffff !important;">
                                                <div class="modal-header" >
                                                    <button type="button" class="close btn-danger btn-circle btn-grad" data-dismiss="modal"><i class="fa fa-times"></i></button>
                                                    <h4 class="modal-title">@item2.Products.productName - @item2.ProductOptions.productOptionName Details</h4>
                                                    <table>
                                                        <tbody>
                                                            <tr>
                                                                <td style="width:25%;">Floor: @item2.Orders.TableSessions.Tables.Floors.floorName</td>
                                                                <td style="width:25%;">Table: @item2.Orders.TableSessions.Tables.tableName</td>
                                                                <td style="width:10%;"></td>
                                                                <td style="width:40%;">Ordered: @DateTime.Now.Subtract(item2.Orders.orderDate).Hours h @DateTime.Now.Subtract(item.orderDate).Minutes min ago</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="modal-body" style="padding:0px !important;">
                                                    @{
                                                        int leftColumnCount = 0, rightColumnCount = 0;
                                                        int productOptionCount = item2.OrderProductExtras.Where(z => z.orderProductId == item2.orderProductId).Count();
                                                        int productOptionCountModTwo = productOptionCount % 2;

                                                        if (productOptionCountModTwo == 0)
                                                        {
                                                            leftColumnCount = productOptionCount / 2; rightColumnCount = productOptionCount / 2;
                                                        }
                                                        else
                                                        {
                                                            leftColumnCount = (productOptionCount + 1) / 2;
                                                            rightColumnCount = productOptionCount - leftColumnCount;
                                                        }
                                                    }
                                                    <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                                                        <div class="col-md-6" style="padding-left:0px !important; padding-right:0px !important;">
                                                            @foreach (var item3 in item2.OrderProductExtras.Where(z => z.orderProductId == item2.orderProductId).OrderBy(p => p.orderProductExtraId).Take(leftColumnCount))
                                                            {
                                                                counter2++;
                                                                <div class="col-md-6" style="padding-top:10px; padding-bottom:10px; background-color:@if (counter2 % 2 == 0){<text>#EEEEEE</text>}else{<text>#9FC5F8</text>};">
                                                                    @item3.ProductExtras.productExtraName
                                                                </div>
                                                                <div class="col-md-6" style="text-align:right; background-color:@if (counter2 % 2 == 0){<text>#EEEEEE</text>}else{<text>#9FC5F8</text>};">
                                                                    <a class="btn btn-success btn-metis-5 btn-circle btn-grad"><i class="fa fa-check"></i></a>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="col-md-6" style="padding-left:0px !important; padding-right:0px !important;">
                                                            @foreach (var item3 in item2.OrderProductExtras.Where(z => z.orderProductId == item2.orderProductId).OrderBy(p => p.orderProductExtraId).Skip(leftColumnCount).Take(rightColumnCount))
                                                            {
                                                                counter3++;

                                                                <div class="col-md-6" style="padding-top:10px; padding-bottom:10px; background-color:@if (counter3 % 2 == 0){<text>#9FC5F8</text>}else{<text>#EEEEEE</text>};">
                                                                    @item3.ProductExtras.productExtraName
                                                                </div>
                                                                <div class="col-md-6" style="text-align:right; background-color:@if (counter3 % 2 == 0){<text>#9FC5F8</text>}else{<text>#EEEEEE</text>};">
                                                                    <a class="btn btn-success btn-metis-5 btn-circle btn-grad"><i class="fa fa-check"></i></a>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="modal-footer" style="padding:0px !important;">
                                                    <div class="row" style="background-color:#9FC5F8; margin-left:0px !important; margin-right:0px !important;">
                                                        <div class="col-md-12" style="padding:0px !important; border-top:0px solid azure !important;">
                                                            <a id="changeOrderProductsStatus" class="btn btn-metis-5 btn-lg btn-grad" data-dismiss="modal" style="min-width:100%"><i class="fa fa-chevron-left"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.modal-content -->
                                        </div>
                                        <!-- /.modal-dialog -->
                                    </div>
                                </div>
                            <!-- /#helpModal -->
                            }
                            <!-- Each ordered item: end -->
                            <!-- Order note: start -->
                            <div class="row btn-grad btn-metis-6" style="width:100%; margin-left:0px !important; margin-right:0px !important;">
                                <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                                    <div class="col-md-3" style="padding-top:10px; padding-bottom:10px;">
                                        <span style="color:white;">Order Note:</span>
                                    </div>
                                </div>
                                <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                                    <div class="col-md-12" style="padding-top:10px; padding-bottom:10px; text-align:left;">
                                        <span style="color:white;">@item.note</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Order note: end -->
                            <!-- Undo confirmation of all items: start -->
                            <div class="row" style="margin-left:0px !important; margin-right:0px !important;">
                                <div class="col-md-12" style="padding-left:0px !important; padding-right:0px !important;">
                                    <a id="confirmingAllOrderProducts_ID" onclick="XConfirmingAllOrderProducts(this.name)" name="@item.orderId" class="btn btn-danger btn-lg btn-grad" style="min-width:100%"><i class="fa fa-undo"></i></a>
                                </div>
                            </div>
                            <!-- Undo confirmation of all items: end -->

                        </div>
                    </div>
                </div>
                }
            <!-- Each order: end -->
        </div>
        <!-- Row of 4 orders: end -->
