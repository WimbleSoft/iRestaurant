@{
    ViewBag.Title = "Tables";
    Layout = "~/Views/Shared/branchAdmin_Layout.cshtml";
}
@model iRestaurant.Controllers.ViewModelDemoVM
@foreach (var a in Model.Employees.Where(x => x.employeeId == (int)Session["loggedInEmployeeId"]))
{
    <div class="modal fade bs-example-modal-lg" id="updateSettingsModal_@a.employeeId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Edit Settings</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Name</label>
                                <input name="employeeName" type="text" id="employeeName_id_@a.employeeId" class="form-control" placeholder="Enter employee name" value="@a.employeeName">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Password</label>
                                <input name="employeePassword" type="password" required min="8" max="20" id="employeePassword_id_@a.employeeId" class="form-control" placeholder="Enter employee password">
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Email</label>
                                <input name="employeeEmail" type="text" id="employeeEmail_id_@a.employeeId" @if (a.isManager == false) { <text> disabled="disabled" readonly="readonly" </text>    } class="form-control" placeholder="Enter employee email" value="@a.employeeEmail">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Phone</label>
                                <input name="employeePhone" type="text" id="employeePhone_id_@a.employeeId" class="form-control" placeholder="Enter employee phone" value="@a.employeePhone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Actions</label>
                            <div class="row">
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                </div>
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" onclick="updateSettings(this.id)" id="updateSettings_id_@a.employeeId" class="btn btn-warning btn-md btn-grad form-control">Update</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div id="content">
    <script>
        document.getElementById("tables").className = "active";
    </script>
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                Tables
            </h1>
            <ol class="breadcrumb">
                <li class="active"><a href="#"><i class="fa fa-dashboard"></i> Dashboard</a></li>
                <li><a href="#">Tables</a></li>
            </ol>
        </section>

        <!-- Main content -->
        <section class="content">
            <div class="row">
                <div class="col-xs-12 col-lg-12 col-sm-12 col-md-12">
                    <div class="box">
                        <div class="box-header">
                            <div class="col-md-12">
                                <div class="box box-default collapsed-box">
                                    <div class="box-header with-border">
                                        <h3 class="box-title">
                                            <button type="button" class="btn btn-lg btn-box-tool" style="color:black !important; font-weight:600; " data-widget="collapse">
                                                <i class="fa fa-plus"></i> &nbsp;&nbsp; Add New Table
                                            </button>
                                        </h3>
                                    </div>
                                    <div class="box-body">
                                        <div class="box-body">
                                            <div class="form-group">
                                                <div class="col-md-2 col-lg-3 col-xs-12 col-sm-12">
                                                    <label>Table Name</label>
                                                    <input name="tableName" required type="text" id="tableName" class="form-control" placeholder="Enter table name">
                                                </div>
                                                <div class="col-md-2 col-lg-3 col-xs-12 col-sm-12">
                                                    <label>Floor</label>
                                                    <select id="floorId" required name="floorId" class="form-control Select2 ">
                                                        @foreach(var c in Model.Floors)
                                                        {
                                                            <option value="@c.floorId">@c.floorName</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-2 col-lg-3 col-xs-12 col-sm-12">
                                                    <label>Actions</label>
                                                    <button type="button" onclick="addTable()" class="btn btn-primary btn-md btn-grad form-control">Add Table</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="box-body">
                            <table id="example1" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Table Id</th>
                                        <th>Table Name</th>
                                        <th>Floor Name</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.Tables)
                                    {
                                        <tr>
                                            <td>@a.tableId</td>
                                            <td>@a.tableName</td>
                                            <td>@a.Floors.floorName</td>
                                            <td>
                                                <span class="button-group">
                                                    <button type="button" class="btn btn-warning btn-md btn-grad fa fa-pencil" data-toggle="modal" data-target="#myModalId_@a.tableId"></button>
                                                    <a href="#"name="@a.tableId" onclick="deleteTable(this.name)" class="btn btn-danger btn-md btn-grad fa fa-trash"></a>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!-- Edit table modals -->
                        @foreach (var a in Model.Tables)
                        {
                        
                            <div class="modal fade bs-example-modal-lg" id="myModalId_@a.tableId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                                <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                            <h4 class="modal-title" id="myModalLabel">Edit Table</h4>
                                        </div>
                                        <div class="modal-body">
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-4 col-lg-6 col-xs-12 col-sm-12">
                                                        <label>Table Name</label>
                                                        <input name="tableName_@a.tableId" required type="text" id="tableName_@a.tableId" class="form-control" placeholder="Enter table name" value="@a.tableName">
                                                        <input name="tableId_@a.tableId" type="text" id="tableId_@a.tableId" hidden="hidden" value="@a.tableId">
                                                    </div>
                                                    <div class="col-md-4 col-lg-6 col-xs-12 col-sm-12">
                                                        <label>Floor</label>
                                                        <select id="floorId_@a.tableId" required name="floorId_@a.tableId" class="form-control Select2 ">
                                                            <option selected="selected" value="@a.floorId">Select floor</option>
                                                            @foreach (var b in Model.Floors)
                                                            {
                                                                <option value="@b.floorId">@b.floorName</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-4 col-lg-12 col-xs-12 col-sm-12">
                                                        <label>Actions</label>
                                                        <div class="row">
                                                            <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                                                <button type="button" class="btn btn-default btn-md btn-grad form-control " data-dismiss="modal">Cancel</button>
                                                            </div>
                                                            <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                                                <button type="button" name="@a.tableId" onclick="editTable(this.name)" class="btn btn-warning btn-md btn-grad form-control ">Save</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                </div>
            </div>
        </section>
    </div>
</div>
<script>
function addTable() {
    var tableName  =   $('#tableName').val();
    var floorId = $('#floorId').val();
    if (tableName != "" && floorId != "") {
        $.ajax({
            type: 'POST',
            url: '/BranchAdmin/AddTable/',
            contentType: "application/json; charset=utf-8",
            dataType: 'json',
            data: JSON.stringify({ floorId: floorId, tableName: tableName, branchId: branchId }),
            success: function (data) {
                if (data == 0) {
                    location.reload(true);
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
    else {
        alertFillFields();
    }
   
}
function editTable(tableId) {
    var tableName   =  $('#tableName_' +   tableId).val();
    var floorId = $('#floorId_' + tableId).val();
    if (tableName != "" && floorId != "") {
        $.ajax({
            type: 'POST',
            url: '/BranchAdmin/UpdateTable/',
            dataType: 'json',
            data: { tableName: tableName, floorId: floorId, tableId: tableId, branchId: branchId },
            success: function (data) {
                if (data == 0) {
                    location.reload(true);
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
    else {
        alertFillFields();
    }
    
}
function deleteTable(tableId) {
    if (confirm('Are you sure you want to delete this item? This cannot be undone!')) {
        $.ajax({
            type: 'POST',
            url: '/BranchAdmin/DeleteTable/',
            dataType: 'json',
            data: { tableId: tableId, branchId: branchId },
            success: function (data) {
                if (data == 0) {
                    location.reload(true);
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
    else {
        alertOperationCancelled();
    }
}
</script>
