@{
    ViewBag.Title = "Floors";
    Layout = "~/Views/Shared/branchAdmin_Layout.cshtml";
}
@model iRestaurant.Controllers.ViewModelDemoVM
@foreach (var a in Model.Employees.Where(x => x.employeeId == (int)Session["loggedInEmployeeId"]))
{
    <div class="modal fade bs-example-modal-lg" id="updateSettingsModal_@a.employeeId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Edit Settings</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Name</label>
                                <input name="employeeName" type="text" id="employeeName_id_@a.employeeId" class="form-control" placeholder="Enter employee name" value="@a.employeeName">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Password</label>
                                <input name="employeePassword" type="password" required min="8" max="20" id="employeePassword_id_@a.employeeId" class="form-control" placeholder="Enter employee password">
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Email</label>
                                <input name="employeeEmail" type="text" id="employeeEmail_id_@a.employeeId" @if (a.isManager == false) { <text> disabled="disabled" readonly="readonly" </text>    } class="form-control" placeholder="Enter employee email" value="@a.employeeEmail">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Phone</label>
                                <input name="employeePhone" type="text" id="employeePhone_id_@a.employeeId" class="form-control" placeholder="Enter employee phone" value="@a.employeePhone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Actions</label>
                            <div class="row">
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                </div>
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" onclick="updateSettings(this.id)" id="updateSettings_id_@a.employeeId" class="btn btn-warning btn-md btn-grad form-control">Update</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script>
document.getElementById("floor").className = "active";
</script>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            Floors
        </h1>
        <ol class="breadcrumb">
            <li class="active"><a href="#"><i class="fa fa-dashboard"></i> Dashboard</a></li>
            <li><a href="#">Floors</a></li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                <div class="box">
                    <div class="box-header">
                        <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                            <div class="box box-default collapsed-box">
                                <div class="box-header with-border">
                                    <h3 class="box-title">
                                        <button type="button" class="btn btn-lg btn-box-tool" style="color:black !important; font-weight:600; " data-widget="collapse">
                                            <i class="fa fa-plus"></i> &nbsp;&nbsp; Add New Floor
                                        </button>
                                    </h3>
                                </div>
                                <div class="box-body">
                                    <div class="box-body">
                                        <div class="form-group">
                                            <div class="col-md-2 col-lg-4 col-xs-12 col-sm-6">
                                                <label>Floor Name</label>
                                                <input name="floorName" required type="text" id="floorName" class="form-control" placeholder="Enter floor name">
                                            </div>
                                            <div class="col-md-2 col-lg-4 col-xs-12 col-sm-6">
                                                <label>Actions</label>
                                                <button type="button" onclick="addFloor()" class="btn btn-primary btn-md btn-grad form-control">Add Floor</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="box-body">
                        <table id="example1" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Floor Id</th>
                                    <th>Floor Name</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var floor in Model.Floors.ToList())
                                {
                                <tr>
                                    <td>@floor.floorId</td>
                                    <td>@floor.floorName</td>
                                    <td>
                                        <span class="button-group">
                                            <button type="button" class="btn btn-warning btn-md btn-grad fa fa-pencil" data-toggle="modal" data-target="#myModalId_@floor.floorId"></button>
                                            <a href="#" name="@floor.floorId" onclick="deleteFloor(this.name)" class="btn btn-danger btn-md btn-grad fa fa-trash"></a>
                                        </span>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div>
                        <!-- Edit floor modals -->
                        @foreach (var floor in Model.Floors.ToList())
                        {
                        <div class="modal fade bs-example-modal-lg" id="myModalId_@floor.floorId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                        <h4 class="modal-title" id="myModalLabel">Edit Floor</h4>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-4 col-lg-6 col-xs-12 col-sm-12">
                                                    <label>Floor Name</label>
                                                    <input name="floorName_@floor.floorId" required type="text" id="floorName_@floor.floorId" class="form-control" placeholder="Enter floor name" value="@floor.floorName">
                                                    <input name="floorId_@floor.floorId" type="text" id="floorId_@floor.floorId" hidden="hidden" value="@floor.floorId">
                                                </div>
                                                <div class="col-md-4 col-lg-6 col-xs-12 col-sm-12">
                                                    <label>Actions</label>
                                                    <div class="row">
                                                        <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                                            <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                                        </div>
                                                        <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                                            <button type="button" class="btn btn-warning btn-md btn-grad form-control" name="@floor.floorId" onclick="editFloor(this.name)">Save</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<script>
    function addFloor() {
        var floorName = $('#floorName').val();
        if (floorName != "") {
            $.ajax({
                type: 'POST',
                url: '/BranchAdmin/AddFloor/',
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                data: JSON.stringify({ floorName: floorName, branchId: branchId }),
                success: function (data) {
                    if (data == 0) {
                        location.reload(true);
                    }
                    else {
                        alertLoginError();
                    }
                }
            });
        }
        else {
            alertFillFields();
        }
        
    }
    function editFloor(floorId) {
        var floorName = $('#floorName_' + floorId).val();
        var floorId = $('#floorId_' + floorId).val();
        if (floorName != "" && floorId != "") {
            $.ajax({
                type: 'POST',
                url: '/BranchAdmin/UpdateFloor/',
                dataType: 'json',
                data: { floorName: floorName, floorId: floorId, branchId: branchId },
                success: function (data) {
                    if (data == 0) {
                        location.reload(true);
                    }
                    else {
                        alertLoginError();
                    }
                }
            });
        }
        else {
            alertFillFields();
        }
    }
    function deleteFloor(floorId) {
        if (confirm('Are you sure you want to delete this item? This cannot be undone!')) {
            $.ajax({
                type: 'POST',
                url: '/BranchAdmin/DeleteFloor/',
                dataType: 'json',
                data: { floorId: floorId, branchId: branchId },
                success: function (data) {
                    if (data == 0) {
                        location.reload(true);
                    }
                    else {
                        alertLoginError();
                    }
                }
            });
        }
        else {
            alertOperationCancelled();
        }
            
    }
</script>
