@{
    ViewBag.Title = "Employees";
    Layout = "~/Views/Shared/branchAdmin_Layout.cshtml";
}
@model iRestaurant.Controllers.ViewModelDemoVM
@foreach (var a in Model.Employees.Where(x => x.employeeId == (int)Session["loggedInEmployeeId"]))
{
    <div class="modal fade bs-example-modal-lg" id="updateSettingsModal_@a.employeeId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Edit Settings</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Name</label>
                                <input name="employeeName" type="text" id="employeeName_id_@a.employeeId" class="form-control" placeholder="Enter employee name" value="@a.employeeName">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Password</label>
                                <input name="employeePassword" type="password" required min="8" max="20" id="employeePassword_id_@a.employeeId" class="form-control" placeholder="Enter employee password">
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Email</label>
                                <input name="employeeEmail" type="text" id="employeeEmail_id_@a.employeeId" @if (a.isManager == false) { <text> disabled="disabled" readonly="readonly" </text>    } class="form-control" placeholder="Enter employee email" value="@a.employeeEmail">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Phone</label>
                                <input name="employeePhone" type="text" id="employeePhone_id_@a.employeeId" class="form-control" placeholder="Enter employee phone" value="@a.employeePhone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Actions</label>
                            <div class="row">
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                </div>
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" onclick="updateSettings(this.id)" id="updateSettings_id_@a.employeeId" class="btn btn-warning btn-md btn-grad form-control">Update</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div id="content">
    <script>
        document.getElementById("employees").className = "active";
    </script>

    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <!-- Content Header (Page header) -->
        <section class="content-header">
            <h1>
                Employees
            </h1>
            <ol class="breadcrumb">
                <li class="active"><a href="#"><i class="fa fa-dashboard"></i> Dashboard</a></li>
                <li><a href="#">Employees</a></li>
            </ol>
        </section>

        <!-- Main content -->
        <section class="content">
            <div class="row">
                <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                    <div class="box">
                        <div class="box-header">
                            <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                                <div class="box box-default collapsed-box">
                                    <div class="box-header with-border">
                                        <h3 class="box-title">
                                            <button type="button" class="btn btn-lg btn-box-tool" style="color:black !important; font-weight:600; " data-widget="collapse">
                                                <i class="fa fa-plus"></i> &nbsp;&nbsp; Add New Employee
                                            </button>
                                        </h3>
                                    </div>
                                    <div class="box-body">
                                        <div class="box-body">
                                            <div class="form-group">
                                                <div class="col-md-2 col-lg-2 col-xs-12 col-sm-12">
                                                    <label>Employee Name</label>
                                                    <input name="employeeName" required type="text" id="employeeName" class="form-control" placeholder="Enter employee name">
                                                </div>
                                                <div class="col-md-2 col-lg-2 col-xs-12 col-sm-12">
                                                    <label>Employee Password</label>
                                                    <input name="employeePassword" required type="password" id="employeePassword" class="form-control" placeholder="Enter employee password">
                                                </div>
                                                <div class="col-md-2 col-lg-2 col-xs-12 col-sm-12">
                                                    <label>Employee Email</label>
                                                    <input name="employeeEmail" required type="email" id="employeeEmail" class="form-control" placeholder="Enter employee email">
                                                </div>
                                                <div class="col-md-2 col-lg-2 col-xs-12 col-sm-12">
                                                    <label>Employee Phone</label>
                                                    <input name="employeePhone" required type="tel" id="employeePhone" class="form-control" placeholder="Enter employee phone">
                                                </div>
                                                <div class="col-md-2 col-lg-2 col-xs-12 col-sm-12">
                                                    <label>Table Mode? <small>Will this employee account actually run in table mode?</small></label>
                                                    <input name="isTableMode" type="checkbox" id="isTableMode" class="form-control" title="The employee uses table mode only. Example name: CUSTOMER MODE">
                                                </div>
                                                <div class="col-md-2 col-lg-2 col-xs-12 col-sm-12">
                                                    <label>Actions</label>
                                                    <button type="button" onclick="addEmployee()" class="btn btn-primary form-control">Add Employee</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="box-body">
                            <table id="example1" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Employee Id</th>
                                        <th>Employee Name</th>
                                        <th>Employee Email</th>
                                        <th>Employee Phone</th>
                                        <th>Employee Permission</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in Model.Employees)
                                    {
                                        <tr>
                                            <td>@a.employeeId</td>
                                            <td>@a.employeeName</td>
                                            <td>@a.employeeEmail</td>
                                            <td>@a.employeePhone</td>
                                            <td>
                                                @{if (a.isManager)
                                                { <text>Manager</text>}
                                                else
                                                { <text>Regular Employee</text>} }
                                            </td>
                                            <td>
                                                <span class="button-group">
                                                    <button type="button" class="btn btn-warning fa fa-pencil" data-toggle="modal" data-target="#myModalId_@a.employeeId"></button>
                                                    <a href="#" name="@a.employeeId" onclick="deleteEmployee(this.name)" class="btn btn-danger btn-md btn-grad fa fa-trash"></a>
                                                </span>



                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @foreach (var a in Model.Employees)
                        {
                            <!-- Edit employee -->
                            <div class="modal fade bs-example-modal-lg" id="myModalId_@a.employeeId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                                <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                            <h4 class="modal-title" id="myModalLabel">Edit Employee</h4>
                                        </div>
                                        <div class="modal-body">
                                            <div class="row">
                                                <div class="form-group">
                                                    <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                                        <label>Employee Name</label>
                                                        <input name="employeeName_@a.employeeId" required type="text" id="employeeName_@a.employeeId" class="form-control" placeholder="Enter employee name" value="@a.employeeName">
                                                        <input name="employeeId_@a.employeeId" type="text" id="employeeId_@a.employeeId" hidden="hidden" value="@a.employeeId">
                                                    </div>
                                                    <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                                        <label>Employee Email</label>
                                                        <input name="employeeEmail_@a.employeeId" required type="email" id="employeeEmail_@a.employeeId" class="form-control" placeholder="Enter employee email" value="@a.employeeEmail">
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                                        <label>Employee Password</label>
                                                        <input name="employeePassword_@a.employeeId" required type="password" id="employeePassword_@a.employeeId" class="form-control" placeholder="Enter employee password">
                                                    </div>
                                                    <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                                        <label>Employee Phone</label>
                                                        <input name="employeePhone_@a.employeeId" required type="tel" id="employeePhone_@a.employeeId" class="form-control" placeholder="Enter employee phone" value="@a.employeePhone">
                                                    </div>
                                                    <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                                        <label>Table Mode? <small>Will this employee account actually run in table mode?</small></label>
                                                        <input name="isTableMode_@a.employeeId" type="checkbox" @if (a.isTableMode) { <text>checked="checked"</text>} id="isTableMode_@a.employeeId">
                                                    </div>
                                                    <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                                        <label>Actions</label>
                                                        <div class="row">
                                                            <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                                                <button type="button" class="btn btn-default btn-md btn-grad form-control " data-dismiss="modal">Cancel</button>
                                                            </div>
                                                            <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                                                <button type="button" name="@a.employeeId" onclick="editEmployee(this.name)" class="btn btn-warning btn-md btn-grad form-control ">Save</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
<script>
    function addEmployee() {
        var employeeName = $('#employeeName').val();
        var employeeEmail = $('#employeeEmail').val();
        var employeePassword = $('#employeePassword').val();
        var employeePhone = $('#employeePhone').val();
        var isTableMode = $('#isTableMode').is(':checked');
        if (employeeName != "" && employeeEmail != "" && employeePassword != "" && employeePhone != "") {
            if (employeePassword.length >= 6 && employeePassword.length <= 12) {
                $.ajax({
                    type: 'POST',
                    url: '/BranchAdmin/AddEmployee/',
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    data: JSON.stringify({ employeeName: employeeName, employeeEmail: employeeEmail, employeePassword: employeePassword, employeePhone: employeePhone, isManager: false, isTableMode: isTableMode, branchId: branchId, companyId: companyId }),
                    success: function (data) {
                        if (data == 0) {
                            location.reload(true);
                        }
                        else if (data == 1) {
                            alertError();
                        }
                        else if (data == 2) {
                            alert("The password must be between 6 and 12 characters.");
                        }
                        else {
                            alertLoginError();
                        }
                    }
                });
            }
            else {
                alert("The password must be between 6 and 12 characters.");
            }
        }
        else {
            alertFillFields();
        }
        
    }
    function editEmployee(employeeId) {
        var employeeName = $('#employeeName_' + employeeId).val();
        var employeeEmail = $('#employeeEmail_' + employeeId).val();
        var employeePassword = $('#employeePassword_' + employeeId).val();
        var employeePhone = $('#employeePhone_' + employeeId).val();
        var isTableMode = $('#isTableMode_' + employeeId).is(':checked');
        if (employeeName != "" && employeeEmail != "" && employeePhone != "") {
            if (employeePassword != null) {
                if (employeePassword.length >= 6 && employeePassword.length <= 12) {
                    $.ajax({
                        type: 'POST',
                        url: '/BranchAdmin/UpdateEmployee/',
                        dataType: 'json',
                        data: { employeeName: employeeName, employeeEmail: employeeEmail, employeeId: employeeId, employeePassword: employeePassword, employeePhone: employeePhone, isManager: false, isTableMode: isTableMode, branchId: branchId, companyId: companyId },
                        success: function (data) {
                            if (data == 0) {
                                location.reload(true);
                            }
                            else if (data == 1) {
                                alertError();
                            }
                            else if (data == 2) {
                                alert("The password must be between 6 and 12 characters.");
                            }
                            else {
                                alertLoginError();
                            }
                        }
                    });
                }
                else {
                    alert("The password must be between 6 and 12 characters.");
                }
            }
            else {
                $.ajax({
                    type: 'POST',
                    url: '/BranchAdmin/UpdateEmployee/',
                    dataType: 'json',
                    data: { employeeName: employeeName, employeeEmail: employeeEmail, employeeId: employeeId, employeePassword: employeePassword, employeePhone: employeePhone, isManager: false, isTableMode: isTableMode, branchId: branchId},
                    success: function (data) {
                        if (data == 0) {
                            location.reload(true);
                        }
                        else if (data == 1) {
                            alertError();
                        }
                        else if (data == 2) {
                            alert("The password must be between 6 and 12 characters.");
                        }
                        else {
                            alertLoginError();
                        }
                    }
                });
            }

        }
        else {
            alertFillFields();
        }
    }
    function deleteEmployee(employeeId) {
        if (confirm('When you delete an employee, all of their orders are reassigned to the CUSTOMER account!')) {
            $.ajax({
                type: 'POST',
                url: '/BranchAdmin/DeleteEmployee/',
                dataType: 'json',
                data: { employeeId: employeeId, branchId: branchId },
                success: function (data) {
                    if (data == 0) {
                        location.reload(true);
                    }
                    else if (data == 1) {
                        alert('The CUSTOMER employee represents all tablets in customer mode and every order placed from them, so the system does not allow it to be deleted.');
                    }
                    else if (data == 2) {
                        alert('You must revoke this employee\'s permissions before removing them.');
                    }
                    else if (data == 3) {
                        alertError();
                    }
                    else {
                        alertLoginError();
                    }
                }
            });
        }
        else {
            alertOperationCancelled();
        }
    }
    function changePermission(employeeId) {
        if (confirm('Are you sure you want to change this permission?')) {
            $.ajax({
                type: 'POST',
                url: '/BranchAdmin/ChangePermission/',
                dataType: 'json',
                data: { employeeId: employeeId, branchId: branchId },
                success: function (data) {
                    if (data==0) {
                        location.reload(true);
                    }
                    else if (data == 2) {
                        alert('You cannot revoke your own permissions. Please log in with another authorized account.');
                    }
                    else if (data == 1) {
                        alertError();
                    }
                    else {
                        alertLoginError();
                    }

                }
            });
        }
        else {
            alertOperationCancelled();
        }
    }
</script>

