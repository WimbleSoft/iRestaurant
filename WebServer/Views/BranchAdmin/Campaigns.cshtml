@{
    ViewBag.Title = "Campaigns";
    Layout = "~/Views/Shared/branchAdmin_Layout.cshtml";
}
@model iRestaurant.Controllers.ViewModelDemoVM
@foreach (var a in Model.Employees.Where(x => x.employeeId == (int)Session["loggedInEmployeeId"]))
{
    <div class="modal fade bs-example-modal-lg" id="updateSettingsModal_@a.employeeId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Edit Settings</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Name</label>
                                <input name="employeeName" type="text" id="employeeName_id_@a.employeeId" class="form-control" placeholder="Enter employee name" value="@a.employeeName">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Password</label>
                                <input name="employeePassword" type="password" required min="8" max="20" id="employeePassword_id_@a.employeeId" class="form-control" placeholder="Enter employee password">
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Email</label>
                                <input name="employeeEmail" type="text" id="employeeEmail_id_@a.employeeId" @if (a.isManager == false) { <text> disabled="disabled" readonly="readonly" </text>    } class="form-control" placeholder="Enter employee email" value="@a.employeeEmail">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Phone</label>
                                <input name="employeePhone" type="text" id="employeePhone_id_@a.employeeId" class="form-control" placeholder="Enter employee phone" value="@a.employeePhone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Actions</label>
                            <div class="row">
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                </div>
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" onclick="updateSettings(this.id)" id="updateSettings_id_@a.employeeId" class="btn btn-warning btn-md btn-grad form-control">Update</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<!-- PAGE CONTENT -->
<script>
    document.getElementById("campaigns").className = "active";
</script>

<div class="content-wrapper">
    <section class="content-header">
        <h1>
            Campaigns
        </h1>
        <ol class="breadcrumb">
            <li class="active"><a href="#"><i class="fa fa-dashboard"></i> Dashboard</a></li>
            <li><a href="#">Campaigns and Campaign Products</a></li>
        </ol>
    </section>
    <section class="content">
        <div class="row">
            <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                <div class="box">
                    <div class="box-header">
                        <div class="col-md-12 col-xs-12 col-sm-12 col-lg-12">
                            <div class="box box-default collapsed-box">
                                <div class="box-header with-border">
                                    <h3 class="box-title">
                                        <button type="button" class="btn btn-lg btn-box-tool" style="color:black !important; font-weight:600; " data-widget="collapse">
                                            <i class="fa fa-plus"></i> &nbsp;&nbsp; Add New Campaign
                                        </button>
                                    </h3>
                                </div>
                                <div class="box-body">
                                    <div class="box-body">
                                        <div class="form-group">
                                            <div class="col-xs-12 col-md-3 col-sm-3 col-lg-3">
                                                <label>Campaign Name</label>
                                                <input name="campaignName"  required type="text" id="campaignName" class="form-control" placeholder="Enter campaign name">
                                            </div>
                                            <div class="col-xs-12 col-md-3 col-sm-3 col-lg-3">
                                                <label>Campaign Price</label>
                                                <input name="campaignPrice" required type="text" id="campaignPrice" class="form-control" placeholder="Enter campaign price">
                                            </div>
                                            <div class="col-xs-12 col-md-3 col-sm-3 col-lg-3">
                                                <label>Campaign Image</label>
                                                <input type="file" name="campaignImage" class="" id="campaignImage" accept="image/*" reject="*/*" runat="server" />
                                            </div>
                                            <div class="col-md-12 col-md-3 col-sm-3 col-lg-3">
                                                <label>Menu</label>
                                                <select name="menuId" id="menuId" class="form-control Select2">
                                                    <option value="" selected>Select a menu</option>
                                                    @foreach(var menu in Model.Menus)
                                                    {
                                                        <option value="@menu.menuId">@menu.menuName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                        <br />
                                    <div class="box-body">
                                        <div class="form-group">
                                            <div class="col-xs-12 col-md-6 col-sm-6 col-lg-6">
                                                <label>Campaign Description</label>
                                                <textarea name="campaignDescription" required type="text" id="campaignDescription" class="form-control" style="resize:none;" placeholder="Enter campaign description"></textarea>
                                            </div>
                                            <div class="col-xs-12 col-md-3 col-sm-3 col-lg-3">
                                                <label>
                                                    Published?
                                                </label>
                                                <div class="checkbox">
                                                    <label>
                                                        <input id="isPublished" type="checkbox" checked />
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-md-3 col-sm-3 col-lg-3">
                                                <label>Actions</label>
                                                <button type="button" onclick="addCampaign()" class="btn btn-primary btn-md btn-grad form-control">Add Campaign</button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /.form -->
                                </div>
                                <!-- /.box-body -->
                            </div>
                            <!-- /.box -->
                        </div>
                    </div>
                    @foreach(var menu in Model.Menus)
                    {
                        <div class="box-header">
                            <div class="col-md-12 col-xs-12 col-sm-12 col-lg-12">
                                <div class="box box-default collapsed-box">
                                    <div class="box-header with-border">
                                        <h3 class="box-title">
                                            <button type="button" class="btn btn-lg btn-box-tool" style="color:black !important; font-weight:600; " data-widget="collapse">
                                                <i class="fa fa-plus"></i> &nbsp;&nbsp;@((menu.menuName+" Campaigns").ToUpper().ToString())
                                            </button>
                                        </h3>
                                    </div>
                                    <div class="box-body">
                                        <table id="example1" class="table table-bordered table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Campaign Image</th>
                                                    <th>Campaign Id</th>
                                                    <th>Campaign Name</th>
                                                    <th>Campaign Price</th>
                                                    <th>Published</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var campaign in Model.Campaigns.Where(x=>x.menuId==menu.menuId).OrderBy(x => x.campaignId))
                                                {
                                                    <tr>
                                                        <td><img width="100" height="100" src="../assets/campaign-images/@campaign.campaignImage" /></td>
                                                        <td>@campaign.campaignId</td>
                                                        <td>@campaign.campaignName</td>
                                                        <td>@campaign.campaignPrice <i class="fa fa-try"></i></td>
                                                        <td>
                                                            @{
                                                                if (campaign.isPublished == true)
                                                                {
                                                                        <text>Active</text>
                                                                }
                                                                else
                                                                {
                                                                        <text>Inactive</text>
                                                                }
                                                            }
                                                        </td>
                                                        <td>
                                                            <span class="button-group">
                                                                <button class="btn btn-warning btn-md btn-grad fa fa-pencil" data-toggle="modal" data-target="#EditCampaign_@campaign.campaignId"></button>
                                                                <button class="btn btn-primary btn-md btn-grad fa fa-info-circle" data-toggle="modal" data-target="#EditCampaignProduct_@campaign.campaignId"></button>
                                                                <button class="btn btn-danger  btn-md btn-grad fa fa-trash" name="@campaign.campaignId" onclick="deleteCampaigns(this.name)"></button>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <!-- /.form -->
                                    </div>
                                    <!-- /.box-body -->
                                </div>
                                <!-- /.box -->
                            </div>
                        </div>
                    }
                </div>
            </div>
            @foreach (var campaign in Model.Campaigns)
            {
                <!-- Edit campaign modal -->
                <div class="modal fade bd-example-modal-lg" id="EditCampaign_@campaign.campaignId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel_EditProduct_@campaign.campaignId">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="myModalLabel_EditProduct_@campaign.campaignId">Edit Campaign: @campaign.campaignName</h4>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-4 col-xs-12 col-sm-4 col-lg-4">
                                            <label>Campaign Name</label>
                                            <input name="campaignName_@campaign.campaignId" required type="text" id="campaignName_@campaign.campaignId" class="form-control" placeholder="Enter campaign name" value="@campaign.campaignName">
                                            <input name="campaignId_@campaign.campaignId" type="text" id="campaignId_@campaign.campaignId" hidden="hidden" value="@campaign.campaignId">
                                        </div>
                                        <div class="col-md-2 col-xs-12 col-sm-4 col-lg-2">
                                            <label>Campaign Price</label>
                                            <input name="campaignPrice_@campaign.campaignId" required type="text" id="campaignPrice_@campaign.campaignId" class="form-control" placeholder="Enter campaign price" value="@campaign.campaignPrice">
                                        </div>
                                        <div class="col-md-2 col-xs-12 col-sm-4 col-lg-2">
                                            <label>
                                                Published?
                                            </label>
                                            <div class="checkbox">
                                                <label>
                                                    <input id="isPublished_@campaign.campaignId" @{if (campaign.isPublished == true) { <text> checked="checked" </text>  }} type="checkbox" />
                                                    <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-xs-12 col-sm-4 col-lg-4">
                                            <label>Menu</label>
                                            <select name="menuId_@campaign.menuId" id="menu_@campaign.menuId" class="form-control Select2">
                                                <option selected value="@campaign.menuId">@campaign.Menus.menuName</option>
                                                @foreach(var menu in Model.Menus.Where(x => x.menuId == campaign.menuId))
                                                {
                                                    <option value="@menu.menuId" >@menu.menuName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <hr>
                                </div>
                                <div class="row" style="margin-top: 10px;">
                                    <div class="form-group">
                                        <div class="col-md-4 col-xs-12 col-sm-6 col-lg-6">
                                            <label>Current Image</label>
                                            <img style="margin-left: 5px !important; margin-right: 5px !important; border:3px;" width="250" height="250" src="../assets/campaign-images/@campaign.campaignImage" />
                                        </div>
                                        <div class="col-md-2 col-xs-12 col-sm-6 col-lg-6">
                                            <label>Campaign Image</label>
                                            <input type="file" name="campaignImage_@campaign.campaignId" id="campaignImage_@campaign.campaignId"  accept="image/*" reject="*/*" runat="server"/>
                                        </div>
                                        <div class="col-md-2 col-xs-12 col-sm-6 col-lg-6">
                                            
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="margin-top: 10px;">
                                    <div class="form-group">
                                        <div class="col-md-12 col-xs-12 col-sm-12 col-lg-6">
                                            <label>Campaign Description</label>
                                            <textarea name="campaignDescription_@campaign.campaignId" required type="text" id="campaignDescription_@campaign.campaignId" class="form-control" style="resize:none;" placeholder="Enter campaign description">@campaign.campaignDescription</textarea>
                                        </div>
                                        <div class="col-md-12 col-xs-12 col-sm-12 col-lg-6">
                                            <label>Actions</label>
                                            <div class="row">
                                                <div class="col-md-6 col-xs-6 col-sm-6 col-lg-6">
                                                    <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                                </div>
                                                <div class="col-md-6 col-xs-6 col-sm-6 col-lg-6">
                                                    <button type="button" onclick="editCampaign(this.name)" name="@campaign.campaignId" class="btn btn-warning btn-md btn-grad form-control">Update</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Add campaign product modal -->
                <div class="modal fade bd-example-modal-lg" id="EditCampaignProduct_@campaign.campaignId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel_EditCampaignProduct_@campaign.campaignId">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="myModalLabel_EditCampaignProduct_@campaign.campaignId">Add Product to @campaign.campaignName</h4>
                            </div>
                            <div class="modal-body">
                                <div class="container-fluid">
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-4 col-lg-4 col-xs-12 col-sm-12">
                                                <label>Product</label>
                                                <select id="productId_@campaign.campaignId" name="productId_@campaign.campaignId" class="form-control Select2 ">
                                                    @foreach (var productCategory in Model.ProductCategories)
                                                    {
                                                        <optgroup label="@productCategory.productCategoryName">
                                                            @foreach (var product in Model.Products.Where(x => x.productCategoryId == productCategory.productCategoryId))
                                                            {
                                                                <option value="@product.productId">@product.productName</option>
                                                            }
                                                        </optgroup>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2 col-lg-2 col-xs-12 col-sm-12">
                                                <label>Action</label>
                                                <button type="button" onclick="addCampaignProduct(this.name)" name="@campaign.campaignId" class="btn btn-warning btn-md btn-grad form-control">Add</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title" id="myModalLabelListOption">Products in @campaign.campaignName</h4>
                            </div>
                            <div class="modal-body">
                                <div class="container-fluid">
                                    <table id="example3" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>Product Name</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var campaignOption in Model.CampaignProducts.Where(x => x.campaignId == campaign.campaignId))
                                            {
                                                <tr>
                                                    <td>@campaignOption.Products.productName</td>
                                                    <td><a href="#" name="@campaignOption.campaignProductId" onclick="deleteCampaignProduct(this.name)" class="btn btn-danger btn-md btn-grad fa fa-trash"></a></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>
<script>

// Edit campaign
function editCampaign(campaignId) {
    var formData = new FormData();
    var campaignName = $('#campaignName_' + campaignId).val();
    var campaignPrice = $('#campaignPrice_' + campaignId).val();
    var campaignDescription = $('#campaignDescription_' + campaignId).val();
    var isPublished = $('#isPublished_' + campaignId).is(":checked");;
    var campaignImage = $('#campaignImage_' + campaignId)[0].files[0];
    var menuId = $('#menuId_' + campaignId).val();

    if (campaignName != "" && campaignPrice != "" && campaignImage != "" && campaignDescription != "" && menuId != "") {
        formData.append("campaignName", campaignName);
        formData.append("campaignId", campaignId);
        formData.append("campaignPrice", campaignPrice);
        formData.append("isPublished", isPublished);
        formData.append("campaignDescription", campaignDescription);
        formData.append("campaignImageFile", campaignImage);
        formData.append("menuId", menuId);
        formData.append("branchId", branchId);
        var xhr = new XMLHttpRequest();
        xhr.open("POST", "/BranchAdmin/UpdateCampaign", true);
        xhr.addEventListener("load",
        function (data) {
            if (data.target.response == 0) {
                location.reload(true);
            }
            else if (data.target.response == 1) {
                alertError();
            }
            else {
                alertLoginError();
            }
        },
            false);
        xhr.addEventListener("error", function (data) { alertError(); }, false);
        xhr.send(formData);
    }
    else {
        alertFillFields();
    }

}
// Add functions
function addCampaign() {
    var campaignName = $('#campaignName').val();
    var campaignPrice = $('#campaignPrice').val();
    var campaignDescription = $('#campaignDescription').val();
    var isPublished = $('#isPublished').is(":checked");
    var campaignImage = $('#campaignImage')[0].files[0];
    var menuId = $('#menuId').val();

    if (campaignName != "" && campaignPrice != "" && campaignImage != "" && campaignDescription != "" && menuId != "")
    {
        var formData = new FormData();
        formData.append("campaignName", campaignName);
        formData.append("campaignPrice", campaignPrice);
        formData.append("campaignDescription", campaignDescription);
        formData.append("isPublished", isPublished);
        formData.append("campaignImageFile", campaignImage);
        formData.append("menuId", menuId);
        formData.append("branchId", branchId);
        var xhr = new XMLHttpRequest();
        xhr.open("POST", "/BranchAdmin/AddCampaign", true);
        xhr.addEventListener("load",
            function (data) {
                if (data.target.response == 0) {
                location.reload(true);
            }
                else if (data.target.response == 1) {
                alertError();
            }
            else {
                alertLoginError();
            }
        },
            false);
        xhr.addEventListener("error", function (data) { alertError(); }, false);
        xhr.send(formData);
    }
    else {
        alertFillFields();
    }
    

}
function addCampaignProduct(campaignId) {
    var productId = $('#productId_' + campaignId).val();
    $.ajax({
        type: 'POST',
        url: '/BranchAdmin/AddCampaignProduct/',
        dataType: 'json',
        contentType: "application/json; charset=utf-8",
        data: JSON.stringify({ campaignProductId: 0, productId: productId, campaignId: campaignId, branchId: branchId }),
        success: function (data) {
            if (data == 0) {
                location.reload(true);
            }
            else if (data == 1) {
                alertError();
            }
            else {
                alertLoginError();
            }
        }
    });
}
// Delete functions
function deleteCampaignProduct(campaignProductId) {
    if (confirm('Are you sure you want to delete this item? This cannot be undone!')) {
        $.ajax({
            type: 'POST',
            url: '/BranchAdmin/DeleteCampaignProduct/',
            dataType: 'json',
            data: { campaignProductId: campaignProductId, branchId: branchId },
            success: function (data) {
                if (data == 0) {
                     location.reload(true);
                }
                else if (data == 1) {
                    alertError();
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
}
function deleteCampaigns(campaignId) {
    if (confirm('Are you sure you want to delete this item? This cannot be undone!')) {
        $.ajax({
            type: 'POST',
            url: '/BranchAdmin/DeleteCampaign/',
            dataType: 'json',
            data: { campaignId: campaignId, branchId: branchId },
            success: function (data) {
                if (data == 0) {
                    location.reload(true);
                }
                else if (data == 1) {
                    alertError();
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
}
</script>