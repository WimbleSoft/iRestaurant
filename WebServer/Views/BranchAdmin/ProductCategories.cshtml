
@{
    ViewBag.Title = "Product Categories";
    Layout = "~/Views/Shared/branchAdmin_Layout.cshtml";
}
@model iRestaurant.Controllers.ViewModelDemoVM
@foreach (var a in Model.Employees.Where(x => x.employeeId == (int)Session["loggedInEmployeeId"]))
{
    <div class="modal fade bs-example-modal-lg" id="updateSettingsModal_@a.employeeId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Edit Settings</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Name</label>
                                <input name="employeeName" type="text" id="employeeName_id_@a.employeeId" class="form-control" placeholder="Enter employee name" value="@a.employeeName">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Password</label>
                                <input name="employeePassword" type="password" required min="8" max="20" id="employeePassword_id_@a.employeeId" class="form-control" placeholder="Enter employee password">
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Email</label>
                                <input name="employeeEmail" type="text" id="employeeEmail_id_@a.employeeId" @if (a.isManager == false) { <text> disabled="disabled" readonly="readonly" </text>    } class="form-control" placeholder="Enter employee email" value="@a.employeeEmail">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Phone</label>
                                <input name="employeePhone" type="text" id="employeePhone_id_@a.employeeId" class="form-control" placeholder="Enter employee phone" value="@a.employeePhone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Actions</label>
                            <div class="row">
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                </div>
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" onclick="updateSettings(this.id)" id="updateSettings_id_@a.employeeId" class="btn btn-warning btn-md btn-grad form-control">Update</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<!-- PAGE CONTENT -->
<script>
document.getElementById("categories").className = "active";
</script>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            Categories
        </h1>
        <ol class="breadcrumb">
            <li class="active"><a href="#"><i class="fa fa-dashboard"></i> Dashboard</a></li>
            <li><a href="#">Categories</a></li>
        </ol>
    </section>
     <section class="content">
        <div class="row">
            <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                <div class="box">
                    <div class="box-header">
                        <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                            <div class="box box-default collapsed-box">
                                <div class="box-header with-border">
                                    <h3 class="box-title">
                                        <button type="button" class="btn btn-lg btn-box-tool" style="color:black !important; font-weight:600; " data-widget="collapse">
                                            <i class="fa fa-plus"></i> &nbsp;&nbsp; Add New Category
                                        </button>
                                    </h3>
                                </div>
                                <div class="box-body">
                                    <div class="box-body">
                                        <div class="form-group">
                                            <div class="col-md-3 col-lg-3 col-xs-12 col-sm-12">
                                                <label>Category Name</label>
                                                <input name="productCategoryName" required type="text" id="productCategoryName" class="form-control" placeholder="Enter category name">
                                            </div>
                                            <div class="col-md-3 col-lg-3 col-xs-12 col-sm-12">
                                                <label>Department</label>
                                                <select id="departmentId" required name="departmentId" class="form-control Select2 ">
                                                    <option selected="selected" value="">Select department</option>
                                                    @foreach (var department in Model.Departments)
                                                    {
                                                        <option value="@department.departmentId">@department.departmentName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3 col-lg-3 col-xs-12 col-sm-12">
                                                <label>Menu</label>
                                                <select id="menuId" required name="menuId" class="form-control Select2 ">
                                                    <option selected="selected" value="">Select menu</option>
                                                    @foreach (var menu in Model.Menus)
                                                    {
                                                        <option value="@menu.menuId">@menu.menuName / @menu.Currencies.currencyName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-1 col-lg-1 col-xs-12 col-sm-12">
                                                <label>Tax %</label>
                                                <input name="taxPercent" required type="number" id="taxPercent" class="form-control" placeholder="%">
                                            </div>
                                            <div class="col-md-2 col-lg-2 col-xs-12 col-sm-12">
                                                <label>Actions</label>
                                                <button type="submit" onclick="addProductCategory()" class="btn btn-primary btn-md btn-grad form-control">Add Category</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="box-body">
                        <table id="example1" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Category Id</th>
                                    <th>Category Name</th>
                                    <th>Tax %</th>
                                    <th>Menu</th>
                                    <th>Department</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var productCategory in Model.ProductCategories) { 
                                <tr>
                                    <td>@productCategory.productCategoryId</td>
                                    <td>@productCategory.productCategoryName</td>
                                    <td>@productCategory.taxPercent</td>
                                    <td>@productCategory.Menus.menuName</td>
                                    <td>@productCategory.Departments.departmentName</td>
                                    <td>
                                        <span class="button-group">
                                            <button type="button" class="btn btn-warning btn-md btn-grad fa fa-pencil" data-toggle="modal" data-target="#myModalId_@productCategory.productCategoryId"></button>
                                            <a href="#" name="@productCategory.productCategoryId" onclick="deleteProductCategory(this.name)" class="btn btn-danger btn-md btn-grad fa fa-trash"></a>
                                        </span>
                                    </td>
                                </tr>
                                } 
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<!-- Edit product category modals -->
@foreach (var productCategory in Model.ProductCategories)
{
<div class="modal fade bs-example-modal-lg" id="myModalId_@productCategory.productCategoryId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Edit Category: @productCategory.productCategoryName</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-3 col-lg-6 col-xs-12 col-sm-12">
                            <label>Category Name</label>
                            <input name="productCategoryName_@productCategory.productCategoryId" required type="text" id="productCategoryName_@productCategory.productCategoryId" class="form-control" placeholder="Enter category name" value="@productCategory.productCategoryName">
                            <input name="productCategoryId_@productCategory.productCategoryId" required type="text" id="productCategoryId_@productCategory.productCategoryId" hidden="hidden" value="@productCategory.productCategoryId">
                        </div>
                        <div class="col-md-3 col-lg-6 col-xs-12 col-sm-12">
                            <label>Department</label>
                            <select id="departmentId_@productCategory.productCategoryId"     required name="departmentId_@productCategory.productCategoryId" class="form-control Select2 ">
                                <option selected="selected" value="@productCategory.departmentId">Select department</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department.departmentId">@department.departmentName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 col-lg-6 col-xs-12 col-sm-12">
                            <label>Tax %</label>
                            <input name="taxPercent_@productCategory.productCategoryId" required type="text" id="taxPercent_@productCategory.productCategoryId" class="form-control" placeholder="%" value="@productCategory.taxPercent">
                        </div>
                        <div class="col-md-3 col-lg-12 col-xs-12 col-sm-12">
                            <label>Actions</label>
                            <div class="row">
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <a class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</a>
                                </div>
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <a onclick="updateProductCategory(this.name)" name="@productCategory.productCategoryId" class="btn btn-warning btn-md btn-grad form-control">Update</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}
<script>
function addProductCategory() {
    var productCategoryName = $('#productCategoryName').val();
    var departmentId = $('#departmentId').val();
    var taxPercent = $('#taxPercent').val();
    var menuId = $('#menuId').val();
    if (productCategoryName != "" && departmentId != "" && taxPercent != "" && menuId != "") {
        $.ajax({
            type: 'POST',
            url: '/BranchAdmin/AddProductCategory/',
            contentType: "application/json; charset=utf-8",
            dataType: 'json',
            data: JSON.stringify({ productCategoryName: productCategoryName, departmentId: departmentId, taxPercent: taxPercent, menuId:menuId, branchId: branchId }),
            success: function (data) {
                if (data == 0) {
                    location.reload(true);
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
    else {
        alertFillFields();
    }
            
}
function updateProductCategory(productCategoryId) {
    var productCategoryName = $('#productCategoryName_' + productCategoryId).val();
    var productCategoryId = $('#productCategoryId_' + productCategoryId).val();
    var taxPercent = $('#taxPercent_' + productCategoryId).val();
    var departmentId = $('#departmentId_' + productCategoryId).val();
    if (productCategoryName != "" && productCategoryId != "" && departmentId != "" && taxPercent != "") {
        $.ajax({
            type: 'POST',
            url: '/BranchAdmin/UpdateProductCategory/',
            dataType: 'json',
            data: { productCategoryName: productCategoryName, productCategoryId: productCategoryId, departmentId: departmentId, menuId:0, taxPercent: taxPercent, branchId: branchId },
            success: function (data) {
                if (data == 0) {
                    location.reload(true);
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
    else {
        alertFillFields();
    }
            
}
function deleteProductCategory(productCategoryId) {
    if (confirm('Are you sure you want to delete this item? This cannot be undone!')) {
        $.ajax({
            type: 'POST',
            url: '/BranchAdmin/DeleteProductCategory/',
            dataType: 'json',
            data: { productCategoryId: productCategoryId, branchId: branchId },
            success: function (data) {
                if (data == 0) {
                    location.reload(true);
                }
                else {
                    alertLoginError();
                }
            }
        });
    }
}
</script>