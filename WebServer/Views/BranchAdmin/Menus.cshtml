@{
    ViewBag.Title = "Menus";
    Layout = "~/Views/Shared/branchAdmin_Layout.cshtml";
}
@model iRestaurant.Controllers.ViewModelDemoVM
@foreach (var a in Model.Employees.Where(x => x.employeeId == (int)Session["loggedInEmployeeId"]))
{
    <div class="modal fade bs-example-modal-lg" id="updateSettingsModal_@a.employeeId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Edit Settings</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Name</label>
                                <input name="employeeName" type="text" id="employeeName_id_@a.employeeId" class="form-control" placeholder="Enter employee name" value="@a.employeeName">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Password</label>
                                <input name="employeePassword" type="password" required min="8" max="20" id="employeePassword_id_@a.employeeId" class="form-control" placeholder="Enter employee password">
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Email</label>
                                <input name="employeeEmail" type="text" id="employeeEmail_id_@a.employeeId" @if (a.isManager == false) { <text> disabled="disabled" readonly="readonly" </text>    } class="form-control" placeholder="Enter employee email" value="@a.employeeEmail">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Phone</label>
                                <input name="employeePhone" type="text" id="employeePhone_id_@a.employeeId" class="form-control" placeholder="Enter employee phone" value="@a.employeePhone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Actions</label>
                            <div class="row">
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                </div>
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" onclick="updateSettings(this.id)" id="updateSettings_id_@a.employeeId" class="btn btn-warning btn-md btn-grad form-control">Update</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script>
document.getElementById("menus").className = "active";
</script>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            Menus
        </h1>
        <ol class="breadcrumb">
            <li class="active"><a href="#"><i class="fa fa-dashboard"></i> Dashboard</a></li>
            <li><a href="#">Menus</a></li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                <div class="box">
                    <div class="box-header">
                        <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12">
                            <div class="box box-default collapsed-box">
                                <div class="box-header with-border">
                                    <h3 class="box-title">
                                        <button type="button" class="btn btn-lg btn-box-tool" style="color:black !important; font-weight:600; " data-widget="collapse">
                                            <i class="fa fa-plus"></i> &nbsp;&nbsp; Add New Menu
                                        </button>
                                    </h3>
                                </div>
                                <div class="box-body">
                                    <div class="box-body">
                                        <div class="form-group">
                                            <div class="col-md-2 col-lg-4 col-xs-12 col-sm-6">
                                                <label>Menu Name</label>
                                                <input name="menuName" required type="text" id="menuName" class="form-control" placeholder="Enter menu name">
                                            </div>
                                            <div class="col-md-2 col-lg-4 col-xs-12 col-sm-6">
                                                <label>Currency</label>
                                                <select id="currencyId" required name="currencyId" class="form-control Select2 ">
                                                    <option selected="selected" value="">Select currency</option>
                                                    @foreach (var currency in Model.Currencies)
                                                    {
                                                        <option value="@currency.currencyId">@currency.currencyName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2 col-lg-4 col-xs-12 col-sm-6">
                                                <label>Actions</label>
                                                <button type="button" onclick="addMenu()" class="btn btn-primary btn-md btn-grad form-control">Add Menu</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="box-body">
                        <table id="example1" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Menu Id</th>
                                    <th>Menu Name</th>
                                    <th>Currency</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var menu in Model.Menus.ToList())
                                {
                                <tr>
                                    <td>@menu.menuId</td>
                                    <td>@menu.menuName</td>
                                    <td>@menu.Currencies.currencyName</td>
                                    <td>
                                        <span class="button-group">
                                            <button type="button" class="btn btn-warning btn-md btn-grad fa fa-pencil" data-toggle="modal" data-target="#myModalId_@menu.menuId"></button>
                                            <a href="#" name="@menu.menuId" onclick="deleteMenu(this.name)" class="btn btn-danger btn-md btn-grad fa fa-trash"></a>
                                        </span>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div>
                        <!-- Edit menu modals -->
                        @foreach (var menu in Model.Menus.ToList())
                        {
                        <div class="modal fade bs-example-modal-lg" id="myModalId_@menu.menuId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                        <h4 class="modal-title" id="myModalLabel">Edit Menu</h4>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-4 col-lg-6 col-xs-12 col-sm-12">
                                                    <label>Menu Name</label>
                                                    <input name="menuAd_@menu.menuId" required type="text" id="menuAd_@menu.menuId" class="form-control" placeholder="Enter menu name" value="@menu.menuName">
                                                    <input name="menuId_@menu.menuId" type="text" id="menuId_@menu.menuId" hidden="hidden" value="@menu.menuId">
                                                </div>
                                                <div class="col-md-4 col-lg-6 col-xs-12 col-sm-12">
                                                    <label>Actions</label>
                                                    <div class="row">
                                                        <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                                            <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                                        </div>
                                                        <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                                            <button type="button" class="btn btn-warning btn-md btn-grad form-control" name="@menu.menuId" onclick="editMenu(this.name)">Save</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<script>
    function addMenu() {
        var menuName = $('#menuName').val();
        var currencyId = $('#currencyId').val();
        if (menuName != "" && currencyId!="") {
            $.ajax({
                type: 'POST',
                url: '/BranchAdmin/AddMenu/',
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                data: JSON.stringify({ menuName: menuName, currencyId: currencyId, branchId: branchId }),
                success: function (data) {
                    if (data == 0) {
                        location.reload(true);
                    }
                    else {
                        alertLoginError();
                    }
                }
            });
        }
        else {
            alertFillFields();
        }
        
    }
    function editMenu(menuId) {
        var menuName = $('#menuAd_' + menuId).val();
        var menuId = $('#menuId_' + menuId).val();
        if (menuName != "" && menuId != "") {
            $.ajax({
                type: 'POST',
                url: '/BranchAdmin/UpdateMenu/',
                dataType: 'json',
                data: { menuName: menuName, menuId: menuId, currencyId: 0, branchId: branchId },
                success: function (data) {
                    if (data == 0) {
                        location.reload(true);
                    }
                    else {
                        alertLoginError();
                    }
                }
            });
        }
        else {
            alertFillFields();
        }
    }
    function deleteMenu(menuId) {
        if (confirm('Are you sure you want to delete this item? This cannot be undone!')) {
            $.ajax({
                type: 'POST',
                url: '/BranchAdmin/DeleteMenu/',
                dataType: 'json',
                data: { menuId: menuId, branchId: branchId },
                success: function (data) {
                    if (data == 0) {
                        location.reload(true);
                    }
                    else {
                        alertLoginError();
                    }
                }
            });
        }
        else {
            alertOperationCancelled();
        }
            
    }
</script>
