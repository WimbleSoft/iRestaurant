
@{
    ViewBag.Title = "Products and Details";
    Layout = "~/Views/Shared/branchAdmin_Layout.cshtml";
}
@model iRestaurant.Controllers.ViewModelDemoVM
@foreach (var a in Model.Employees.Where(x => x.employeeId == (int)Session["loggedInEmployeeId"]))
{
    <div class="modal fade bs-example-modal-lg" id="updateSettingsModal_@a.employeeId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Edit Settings</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Name</label>
                                <input name="employeeName" type="text" id="employeeName_id_@a.employeeId" class="form-control" placeholder="Enter employee name" value="@a.employeeName">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Password</label>
                                <input name="employeePassword" type="password" required min="8" max="20" id="employeePassword_id_@a.employeeId" class="form-control" placeholder="Enter employee password">
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Email</label>
                                <input name="employeeEmail" type="text" id="employeeEmail_id_@a.employeeId" @if (a.isManager == false) { <text> disabled="disabled" readonly="readonly" </text>    } class="form-control" placeholder="Enter employee email" value="@a.employeeEmail">
                            </div>
                            <div class="col-md-6 col-lg-6 col-xs-12 col-sm-12">
                                <label>Employee Phone</label>
                                <input name="employeePhone" type="text" id="employeePhone_id_@a.employeeId" class="form-control" placeholder="Enter employee phone" value="@a.employeePhone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Actions</label>
                            <div class="row">
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                </div>
                                <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
                                    <button type="button" onclick="updateSettings(this.id)" id="updateSettings_id_@a.employeeId" class="btn btn-warning btn-md btn-grad form-control">Update</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<!-- PAGE CONTENT -->
<script>
document.getElementById("products").className = "active";
</script>

<div class="content-wrapper">
    <section class="content-header">
        <h1>
            Products
        </h1>
        <ol class="breadcrumb">
            <li class="active"><a href="#"><i class="fa fa-dashboard"></i> Dashboard</a></li>
            <li><a href="#">Products and Details</a></li>
        </ol>
    </section>
    <section class="content">
        <div class="row">
            <div class="col-md-12 col-xs-12 col-lg-12 col-sm-12">
                <div class="box">
                    <div class="box-header"><!-- Add product bar -->
                        <div class="col-md-12 col-xs-12 col-lg-12 col-sm-12">
                            <div class="box box-default collapsed-box">
                                <div class="box-header with-border">
                                    <h3 class="box-title">
                                        <button type="button" class="btn btn-lg btn-box-tool" style="color:black !important; font-weight:600; " data-widget="collapse">
                                            <i class="fa fa-plus"></i> &nbsp;&nbsp; Add New Product
                                        </button> 
                                    </h3>
                                </div>
                                <div class="box-body">
                                    <div class="box-body">
                                        <div class="form-group">
                                            <div class="col-md-6 col-xs-12 col-lg-3 col-sm-12">
                                                <label>Product Name</label>
                                                <input name="productName" required type="text" id="productName" class="form-control" placeholder="Enter product name">
                                            </div>
                                            <div class="col-md-6 col-xs-12 col-lg-3 col-sm-12">
                                                <label>Product Price</label>
                                                <input name="productPrice" required type="text" id="productPrice" class="form-control" placeholder="Enter product price"/>
                                            </div>
                                            <div class="col-md-6 col-xs-12 col-lg-3 col-sm-12">
                                                <label>Category</label>
                                                <select id="productCategoryId" required name="productCategoryId" class="form-control Select2">
                                                    <option selected="selected">Select a category</option>
                                                    @foreach (var menu in Model.Menus)
                                                    {
                                                        <optgroup label="@menu.menuName">
                                                            @foreach (var category in Model.ProductCategories.Where(x=>x.menuId==menu.menuId))
                                                            {
                                                                <option value="@category.productCategoryId">@category.productCategoryName</option>
                                                            }
                                                        </optgroup>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6 col-xs-12 col-lg-3 col-sm-12">
                                                <label>Product Image</label>
                                                <input type="file" name="productImage" class="" id="productImage"  accept="image/*" reject="*/*" runat="server"/>
                                            </div>
                                        </div>
                                        <br>
                                        <div class="form-group">
                                            <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                                <label>Product Description</label>
                                                <textarea name="productDescription" type="text" id="productDescription" class="form-control" style="resize:none;" placeholder="Enter product description"></textarea>
                                            </div>
                                            <div class="col-md-2 col-xs-12 col-lg-2 col-sm-12">
                                                <label>Stock Alarm Quantity</label>
                                                <input name="productStockAlarmQuantity" required type="number" id="productStockAlarmQuantity" class="form-control" placeholder="Stock alarm quantity">
                                            </div>
                                            <div class="col-md-2 col-xs-12 col-lg-2 col-sm-12">
                                                <label>Preparation Time (min)</label>
                                                <input name="productPreparationTime" type="text" id="productPreparationTime" class="form-control" placeholder="Enter preparation time in minutes">
                                            </div>
                                            <div class="col-md-2 col-xs-12 col-lg-2 col-sm-12">
                                                <label>
                                                    Published?
                                                </label>
                                                <div class="checkbox">
                                                    <label>
                                                        <input id="isPublished" type="checkbox" />
                                                        <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-2 col-xs-12 col-lg-2 col-sm-12">
                                                <label>Actions</label>
                                                <button type="button" onclick="addProduct()" class="btn btn-primary btn-md btn-grad form-control">Add Product</button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /.form -->
                                </div>
                                <!-- /.box-body -->
                            </div>
                            <!-- /.box -->
                        </div>
                    </div><!-- End add product bar -->
                    <div class="box-body"><!-- Product list -->
                        <table id="example1" class="table table-bordered table-striped table-responsive">
                            <thead>
                                <tr>
                                    <th>Product Image</th>
                                    <!--<th>Product Id</th>-->
                                    <th>Product Name</th>
                                    <th>Product Category</th>
                                    <th>Product Price</th>
                                    <th>Preparation Time</th>
                                    <th>Product Stock</th>
                                    <th>Alarm Amount</th>
                                    <th>Published</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.Products.OrderBy(x => x.productId))
                                {
                                <tr id="tr_product_@product.productId">
                                    <td><img width="100" height="100" src="../assets/product-images/@product.productImage"/></td>
                                    <!--<td>@product.productId</td>-->
                                    <td>@product.productName</td>
                                    <td>@product.ProductCategories.productCategoryName</td>
                                    <td>@product.productPrice <i class="fa fa-try"></i></td>
                                    <td>@product.productPreparationTime min</td>
                                    <td>@product.ProductStocks.Sum(x=>x.quantity)</td>
                                    <td>
                                        @if (product.productStockAlarmQuantity == 0)
                                        {
                                            <text>No Alarm</text>
                                        }
                                        else
                                        {
                                            <text>@product.productStockAlarmQuantity</text>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            if (product.isPublished==true)
                                            {
                                                <text>Active</text>
                                            }
                                            else
                                            {
                                                <text>Inactive</text>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="button-group">
                                            <button class="btn btn-info    btn-md btn-grad fa fa-balance-scale" data-toggle="modal" data-target="#ProductStock_@product.productId"></button>
                                            <button class="btn btn-warning btn-md btn-grad fa fa-pencil" data-toggle="modal" data-target="#EditProduct_@product.productId"></button>
                                            <button class="btn btn-primary btn-md btn-grad fa fa-info-circle" data-toggle="modal" data-target="#EditOption_@product.productId"></button>
                                            <button class="btn btn-success btn-md btn-grad fa fa-user-plus" data-toggle="modal" data-target="#EditExtra_@product.productId"></button>
                                            <button class="btn btn-danger  btn-md btn-grad fa fa-trash"name="@product.productId" onclick="deleteProducts(this.name)"></button>
                                        </span>
                                    </td>
                                </tr>
                                if (product.productStockAlarmQuantity>0 && product.ProductStocks.Sum(x => x.quantity)<=product.productStockAlarmQuantity)
                                {
                                    <script type="text/javascript">
                                        $('#tr_product_' + "@product.productId").pulsate({
                                            color: "#f00",
                                            repeat: true
                                        });
                                    </script>
                                }
                            }
                            </tbody>
                        </table>
                    </div><!-- End product list -->
                </div>
            </div>
            @foreach (var product in Model.Products)
            {

                <!-- Edit product modal -->
                <div class="modal fade bd-example-modal-lg" id="EditProduct_@product.productId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel_EditProduct_@product.productId">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="myModalLabel_EditProduct_@product.productId">Edit Product: @product.productName</h4>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-4 col-xs-12 col-lg-3 col-sm-12">
                                            <label>Product Name</label>
                                            <input name="productName"    required type="text" id="productName_@product.productId" class="form-control" placeholder="Enter product name" value="@product.productName">
                                            <input name="productId" required type="text" id="productId_@product.productId" hidden="hidden" value="@product.productId">
                                        </div>
                                        <div class="col-md-3 col-xs-12 col-lg-3 col-sm-12">
                                            <label>Category</label>
                                            <select id="productCategoryId_@product.productId" required name="productCategoryId_@product.productId" class="form-control Select2 ">
                                                <option value="@product.productCategoryId">Select a category</option>
                                                @foreach (var menu in Model.Menus)
                                                {
                                                    <optgroup label="@menu.menuName">
                                                        @foreach (var category in Model.ProductCategories.Where(x=>x.menuId==menu.menuId))
                                                        {
                                                            <option @if (category.productCategoryId == product.productCategoryId) { <text>selected="selected"</text> } value="@category.productCategoryId">@category.productCategoryName</option>
                                                        }
                                                    </optgroup>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3 col-xs-12 col-lg-3 col-sm-12">
                                            <label>Preparation Time (min)</label>
                                            <input name="productPreparationTime_@product.productId" type="number" id="productPreparationTime_@product.productId" class="form-control" placeholder="Enter preparation time" value="@product.productPreparationTime">
                                        </div>
                                        <div class="col-md-2 col-xs-12 col-lg-3 col-sm-12">
                                            <label>Product Price</label>
                                            <input name="productPrice_@product.productId" required type="text" id="productPrice_@product.productId" class="form-control" placeholder="Enter product price" value="@product.productPrice">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <hr>
                                </div>
                                <div class="row" style="margin-top: 10px;">
                                    <div class="form-group">
                                        <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                            <label>Current Image</label>
                                            <img style="margin-left: 5px !important; margin-right: 5px !important; border:3px;" width="250" height="250" src="../assets/product-images/@product.productImage" />
                                        </div>
                                        <div class="col-md-8 col-xs-12 col-lg-8 col-sm-12">
                                            <div class="row">
                                                <div class="col-md-5 col-xs-12 col-lg-5 col-sm-12">
                                                    <label>
                                                        Published?
                                                    </label>
                                                    <div class="checkbox">
                                                        <label>
                                                            <input id="isPublished_@product.productId" @{if (product.isPublished == true) { <text> checked="checked" </text>  }} type="checkbox" />
                                                            <span class="cr"><i class="cr-icon glyphicon glyphicon-ok"></i></span>
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 col-xs-12 col-lg-3 col-sm-12">
                                                    <label>Stock Alarm Quantity</label>
                                                    <input name="productStockAlarmQuantity_@product.productId" type="number" id="productStockAlarmQuantity_@product.productId" class="form-control" placeholder="Enter '0' to disable the alarm." value="@product.productStockAlarmQuantity">
                                                </div>
                                                <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                                    <label>Actions</label>
                                                    <span class="btn-group">
                                                        <button type="button" class="btn btn-default btn-md btn-grad form-control" data-dismiss="modal">Cancel</button>
                                                        <button type="button" class="btn btn-warning btn-md btn-grad form-control" onclick="editProduct(this.name)" name="@product.productId">Update</button>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 col-xs-12 col-lg-6 col-sm-12">
                                                    <label>Product Image</label>
                                                    <input type="file" name="productImage_@product.productId" id="productImage_@product.productId"  accept="image/*" reject="*/*" runat="server"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="margin-top: 10px;">
                                    <div class="form-group">
                                        <div class="col-md-12 col-xs-12 col-lg-12 col-sm-12">
                                            <label>Product Description</label>
                                            <textarea name="productDescription_@product.productId" type="text" id="productDescription_@product.productId" class="form-control" style="resize:none;" rows="10" placeholder="Enter product description">@product.productDescription</textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- End edit product modal -->

                <!-- Product stock modal -->
                <div class="modal fade bd-example-modal-lg" id="ProductStock_@product.productId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel_ProductStock_@product.productId">
                    <div class="modal-dialog modal-md" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="myModalLabel_ProductStock_@product.productId">Stock Info: @product.productName</h4>
                            </div>
                            <div class="modal-body">
                                @foreach(var productStock in product.ProductStocks)
                                {
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-3 col-xs-12 col-lg-3 col-sm-12">
                                                <input name="productStockId" required type="text" id="productStockId_@productStock.productStockId" hidden="hidden" value="@productStock.productStockId">
                                                <input name="productStockEntryQuantity_@productStock.productStockId" type="number" id="productStockEntryQuantity_@productStock.productStockId" class="form-control" placeholder="Stock Quantity">
                                            </div>
                                            <div class="col-md-2 col-xs-12 col-lg-3 col-sm-12">
                                                <button class="btn btn-sm btn-info btnAddStock" name="@productStock.productStockId" onclick="">Add Stock</button>
                                            </div><!-- addProductStockEntry(@productStock.productStockId) -->
                                        </div>
                                    </div>
                                    <div class="row">
                                        <hr>
                                    </div>
                                    <div class="row" style="margin-top:10px;">
                                        <div class="container-fluid">
                                            <table id="tableProductStockEntry_@productStock.productStockId" class="table table-bordered table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Quantity</th>
                                                        <th>Date</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tbodyProductStockEntry_@productStock.productStockId">
                                                    @foreach (var productStockEntry in productStock.ProductStockEntries.OrderByDescending(x=>x.productStockEntryDate))
                                                    {
                                                        <tr id="tr_productStockEntries_@productStockEntry.productStockEntryId">
                                                            <td>@productStockEntry.productStockEntryQuantity</td>
                                                            <td>@productStockEntry.productStockEntryDate</td>
                                                            <td><button type="button" name="@productStockEntry.productStockEntryId" class="btn btn-danger fa fa-trash btnDeleteStock"></button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                                
                            </div>
                        </div>
                    </div>
                </div>
                <!-- End product stock modal -->

                <!-- Edit product options modal -->
                <div class="modal fade bd-example-modal-lg" id="EditOption_@product.productId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel_EditOption_@product.productId">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="myModalLabel_EditOption_@product.productId">Add Option to @product.productName</h4>
                            </div>
                            <div class="modal-body">
                                <div class="container-fluid">
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                                <label>Option Name</label>
                                                <input name="productOptionName_@product.productId"    required type="text" id="productOptionName_@product.productId" class="form-control" placeholder="Enter name">
                                            </div>
                                            <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                                <label>Option Price</label>
                                                <input name="productOptionPrice_@product.productId" required type="text" id="productOptionPrice_@product.productId" class="form-control" placeholder="Enter price">
                                            </div>
                                            <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                                <label>Action</label>
                                                <button type="button" onclick="addProductOption(this.name)" name="@product.productId" class="btn btn-warning btn-md btn-grad form-control">Add</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title" id="myModalLabelListOption">Options for @product.productName</h4>
                            </div>
                            <div class="modal-body">
                                <div class="container-fluid">
                                    <table id="example3" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>Option Name</th>
                                                <th>Option Price</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var productOption in Model.ProductOptions.Where(x => x.productId == product.productId))
                                            {
                                                <tr>
                                                    <td>@productOption.productOptionName</td>
                                                    <td>@productOption.productOptionPrice</td>
                                                    <td><a href="#" name="@productOption.productOptionId" onclick="deleteProductOption(this.name)" class="btn btn-danger fa fa-trash"></a></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- End edit product options modal -->

                <!-- Edit product extras modal -->
                <div class="modal fade bd-example-modal-lg" id="EditExtra_@product.productId" tabindex="-1" role="dialog" aria-labelledby="myModalLabel_EditExtra_@product.productId">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="myModalLabel_EditExtra_@product.productId">Add Extra to @product.productName</h4>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-md-12 col-xs-12 col-lg-12 col-sm-12">
                                        <div class="row">
                                            <div class="form-group">
                                                <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                                    <label>Extra Name</label>
                                                    <input name="productExtraName_@product.productId"      required type="text" id="productExtraName_@product.productId" class="form-control" placeholder="Enter name">
                                                    <input name="productId_@product.productId"         required type="text" id="productId_@product.productId" hidden="hidden" value="@product.productId">
                                                </div>
                                                <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                                    <label>Extra Price</label>
                                                    <input name="productExtraPrice_@product.productId"   required type="text" id="productExtraPrice_@product.productId" class="form-control" placeholder="Enter price">
                                                </div>
                                                <div class="col-md-4 col-xs-12 col-lg-4 col-sm-12">
                                                    <label>Action</label>
                                                    <button type="button" onclick="addProductExtra(this.name)" name="@product.productId" class="btn btn-warning btn-md btn-grad form-control">Add</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-content">
                            <div class="modal-header">
                                <h4 class="modal-title" id="myModalLabelListExtra">Extra List</h4>
                            </div>
                            <div class="modal-body">
                                <div class="container-fluid">
                                    <table id="example4" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>Extra Name</th>
                                                <th>Extra Price</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var productExtra in Model.ProductExtras.Where(x => x.productId == product.productId))
                                            {
                                                <tr>
                                                    <td>@productExtra.productExtraName</td>
                                                    <td>@productExtra.productExtraPrice</td>
                                                    <td><a href="#" name="@productExtra.productExtraId" onclick="deleteProductExtras(this.name)" class="btn btn-danger btn-md btn-grad fa fa-trash"></a></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- End edit product extras modal -->
            } 
        </div>
    </section>
</div>
<script>
    $(document).ready(function () {
        $('.table').DataTable({
            "paging": true,
            "lengthChange": true,
            "searching": true,
            "ordering": true,
            "info": false,
            "autoWidth": true
        });
    });
    /*
    $(function () {
        $('.table-nosearchbar').DataTable({
            "searching": false
        });
    });
    */
</script>
<script>




// Edit product
    function editProduct(productId) {
        var formData = new FormData();
        var productName = $('#productName_' + productId).val();
        var productId = $('#productId_' + productId).val();
        var productCategoryId = $('#productCategoryId_' + productId).val();
        var productPrice = $('#productPrice_' + productId).val();
        var productDescription = $('#productDescription_' + productId).val();
        var productPreparationTime = $('#productPreparationTime_' + productId).val();
        var isPublished = $('#isPublished_' + productId).is(":checked");;
        var productStockAlarmQuantity = $('#productStockAlarmQuantity_' + productId).val();;
        var productImage = $('#productImage_' + productId)[0].files[0];

        if (productName != "" && productCategoryId != "" && productPrice != "" && productStockAlarmQuantity !="") {
            formData.append("productName", productName);
            formData.append("productId", productId);
            formData.append("productCategoryId", productCategoryId);
            formData.append("productPrice", productPrice);
            formData.append("isPublished", isPublished);
            formData.append("productStockAlarmQuantity", productStockAlarmQuantity);
            formData.append("productDescription", productDescription);
            formData.append("productPreparationTime", productPreparationTime);
            formData.append("productImageFile", productImage);
            formData.append("branchId", branchId);
            var xhr = new XMLHttpRequest();
            xhr.open("POST", "/BranchAdmin/UpdateProduct", true);
            xhr.addEventListener("load",
                function (data) {
                    if (data.target.response == 0) {
                        location.reload(true);
                    }
                    else if (data.target.response == 1) {
                        alertError();
                    }
                    else if (data.target.response == 2) {
                        alert("The product you are trying to update does not exist in the database.");
                        location.reload(true);
                    }
                    else {
                        alertLoginError();
                    }
                },
                false);
            xhr.addEventListener("error", function (data) { alertError(); }, false);
            xhr.send(formData);
        }
        else {
            alert("Please specify the product name, category and price.");
        }

    }

